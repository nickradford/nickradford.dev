---
export const prerender = true;
import Base from "../layouts/BaseLayout.astro";
import Text from "../components/Text.astro";
import Page from "../components/Page.astro";
import PageHeader from "../components/PageHeader.astro";
import { DecodeText } from "../components/DecodeText";

const description = "Some of the articles and other writings by people who inspire me.";
let links: {
  title: string;
  url: string;
  authorName: string;
  twitterUsername: string;
  imageUrl?: string | null;
  notes?: string | null;
}[] = [];

try {
  const { links: importedLinks } = await import("src/content/inspoLinks/index.json");
  links = importedLinks;
} catch {
  links = [];
}

const normalizedLinks = links.map((link) => {
  const twitterUsername = link.twitterUsername.replace(/^@+/, "").trim();
  const hostname = (() => {
    try {
      return new URL(link.url).hostname.replace(/^www\./, "");
    } catch {
      return link.url;
    }
  })();

  return {
    ...link,
    twitterUsername,
    notes: link.notes?.trim(),
    hostname,
    twitterProfileUrl: twitterUsername ? `https://x.com/${twitterUsername}` : undefined,
  };
});
---

<Base title="Links" description={description}>
  <Page>
    <article class="border-l border-r border-orange/20 dark:border-zinc-800 w-full">
      <PageHeader>
        <DecodeText
          slot="title"
          client:load
          value="Links"
          className="text-4xl md:text-5xl font-geist-mono font-bold tracking-tight leading-tight text-zinc-900 dark:text-zinc-50"
        />
        <Text slot="description">{description}</Text>
      </PageHeader>

      <div class="w-full flex-col space-y-0 divide-y divide-orange/20 dark:divide-zinc-800 border-b border-orange/20 dark:border-zinc-800">
        {
          normalizedLinks.map((link, index) => (
            <div class="flex md:divide-x divide-orange/20 dark:divide-zinc-800">
              <div class="hidden md:flex flex-1" />
              <article class="max-w-4xl w-full group px-8 md:px-16 py-8 md:py-9 hover:bg-orange/5 dark:hover:bg-zinc-900/40 transition-colors">
                <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 md:gap-8">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-3 text-[11px] uppercase tracking-[0.18em] font-geist-mono text-zinc-500 dark:text-zinc-400">
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <span aria-hidden="true">•</span>
                      <span>{link.hostname}</span>
                    </div>

                    <h2 class="mt-3">
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener nofollow"
                        class="inline-flex items-center gap-2 text-2xl md:text-3xl font-geist-mono font-bold tracking-tight leading-[1.2] text-zinc-900 dark:text-zinc-50 hover:text-orange dark:hover:text-orange transition-colors"
                      >
                        <span>{link.title}</span>
                        <i class="ph ph-arrow-up-right text-lg md:text-xl shrink-0" />
                      </a>
                    </h2>

                    {
                      link.notes && (
                        <p class="mt-4 max-w-2xl text-sm md:text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
                          {link.notes}
                        </p>
                      )
                    }

                    <div class="mt-4 flex flex-wrap items-center gap-2 md:gap-3 text-sm font-geist-mono text-zinc-600 dark:text-zinc-300">
                      <span class="text-zinc-900 dark:text-zinc-100">{link.authorName}</span>
                      {link.twitterUsername && <span aria-hidden="true">•</span>}
                      {link.twitterUsername && link.twitterProfileUrl && (
                        <a
                          href={link.twitterProfileUrl}
                          target="_blank"
                          rel="noopener nofollow"
                          class="hover:text-orange dark:hover:text-orange transition-colors"
                        >
                          @{link.twitterUsername}
                        </a>
                      )}
                    </div>
                  </div>

                  {
                    link.imageUrl && (
                      <a href={link.url} target="_blank" rel="noopener nofollow" class="md:justify-self-end">
                        <img
                          src={link.imageUrl}
                          alt={link.title}
                          loading="lazy"
                          class="w-full md:w-55 aspect-4/3 object-cover rounded-lg ring-1 ring-orange/20 dark:ring-zinc-700 bg-zinc-100 dark:bg-zinc-900"
                        />
                      </a>
                    )
                  }
                </div>
              </article>
              <div class="hidden md:flex flex-1" />
            </div>
          ))
        }
        {
          normalizedLinks.length === 0 && (
            <div class="flex md:divide-x divide-orange/20 dark:divide-zinc-800">
              <div class="hidden md:flex flex-1" />
              <div class="max-w-4xl w-full px-8 md:px-16 py-14">
                <div class="rounded-2xl border border-dashed border-orange/30 dark:border-zinc-800 bg-orange/5 dark:bg-zinc-900/40 p-8 md:p-10">
                  <p class="font-geist-mono text-sm md:text-base text-zinc-600 dark:text-zinc-300">
                    No links yet. Add your first entry in Keystatic under <code>Inspo Links</code>.
                  </p>
                </div>
              </div>
              <div class="hidden md:flex flex-1" />
            </div>
          )
        }
      </div>
    </article>
  </Page>
</Base>
