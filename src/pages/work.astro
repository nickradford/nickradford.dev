---
export const prerender = false;
import Base from "../layouts/BaseLayout.astro";
import Text from "../components/Text.astro";
import Page from "../components/Page.astro";
import { DecodeText } from "../components/DecodeText";
import Frame from "src/components/Frame.astro";
import PageHeader from "src/components/PageHeader.astro";

import jobs from "../../jobs";
import { getWorkSlug } from "../lib/work";

const workViewCookieName = "work-view";
const workViewCookie = Astro.cookies.get(workViewCookieName)?.value;
const workDetailsParam = Astro.url.searchParams.get("details");
const requestedWorkDetailSlug = workDetailsParam === "all" ? null : workDetailsParam;
const initialWorkView =
  workViewCookie === "detailed" || workDetailsParam === "all" ? "detailed" : "minimal";
const isInitiallyDetailed = initialWorkView === "detailed";

const isJobInitiallyExpanded = (company: string) =>
  isInitiallyDetailed || requestedWorkDetailSlug === getWorkSlug(company);

const operatingPrinciples = [
  {
    title: "Start with the user workflow",
    description: "Turn messy needs into clear product direction and thoughtful interaction design.",
  },
  {
    title: "Work across the whole system",
    description: "Move between frontend, backend, data, and operations to solve the real problem.",
  },
  {
    title: "Ship with judgment",
    description: "Weigh user empathy, business needs, and engineering rigor when deciding what to ship.",
  },
];

const technicalRange = [
  { label: "TypeScript" },
  { label: "React" },
  { label: "Next.js" },
  { label: "TanStack" },
  { label: "Node.js" },
  { label: "PostgreSQL" },
  { label: "Drizzle ORM" },
  { label: "Tailwind CSS" },
  { label: "Cloudflare stack", detail: "Workers, Queues, R2" },
  { label: "Payments infra", detail: "Stripe, Shopify, Autumn, RevenueCat" },
  { label: "Analytics and debugging", detail: "Sentry, PostHog" },
  { label: "Automated testing", detail: "Vitest, Playwright" },
];

const detailJobStaggerMs = 100;
const detailLineStaggerMs = 35;
const detailItemOffsetMs = 60;

const getDetailPanelDelay = (jobIndex: number) => `${jobIndex * detailJobStaggerMs}ms`;

const getDetailItemDelay = (jobIndex: number, lineIndex: number) =>
  `${jobIndex * detailJobStaggerMs + detailItemOffsetMs + lineIndex * detailLineStaggerMs}ms`;

const getDetailLineIndex = (hasSummary: boolean, lineIndex: number) =>
  (hasSummary ? 1 : 0) + lineIndex;

// Helper to format dates - show full date for first 2 items, year only for rest
const formatDate = (dateStr: string, index: number) => {
  if (index < 2) return dateStr;
  // Extract just the year (last 4 characters)
  return dateStr.split(" ").pop();
};

// Format the date range, collapsing if start and end year are the same
const formatDateRange = (startDate: string, endDate: string, index: number) => {
  const start = formatDate(startDate, index);
  const end = formatDate(endDate, index);

  // For newer items (with full dates), always show both
  if (index < 2) return `${start} — ${end}`;

  // For older items (year only), show just year if they match
  return start === end ? start : `${start} — ${end}`;
};
---

<Base
  title="Work"
  description="Staff Product Engineer with 10+ years building production web applications, internal tools, design systems, developer platforms, and full-stack SaaS products."
>
  <Page class="min-h-[calc(100vh-64px)]">
    <article class="border-l border-r border-accent/20 dark:border-zinc-800 w-full flex-1 flex flex-col">
      {/* Header Section */}
      <PageHeader>
        <div
          slot="title"
          class="flex flex-col md:flex-row md:items-center md:justify-between gap-6"
        >
          <DecodeText
            client:load
            value="Work"
            className="text-4xl md:text-5xl font-geist-mono font-bold tracking-tight leading-tight text-zinc-900 dark:text-zinc-50"
          />
          <a
            href="/nick-radford-resume-2026-06-18.pdf"
            download="Nick Radford Resume.pdf"
            class="inline-flex items-center gap-2 px-6 py-3 text-sm font-geist-mono font-medium text-zinc-900 bg-accent hover:bg-accent/90 transition-colors whitespace-nowrap flex-shrink-0 squircle"
            data-umami-event="Download Resume"
            data-umami-event-resume-version="nick-radford-resume-2026-06-18.pdf"
          >
            Download resume <i class="ph ph-file-pdf text-lg"></i>
          </a>
        </div>
        <Text slot="description">
          Staff Product Engineer with 10+ years building production web applications, internal
          tools, design systems, developer platforms, and full-stack SaaS products.
        </Text>
      </PageHeader>

      <section class="w-full border-b border-accent/20 dark:border-zinc-800">
        <div class="flex md:divide-x divide-accent/20 dark:divide-zinc-800">
          <div class="site-left-rail hidden md:flex" />
          <div class="max-w-4xl w-full">
            <div class="px-8 md:px-16 py-8 md:py-10 space-y-6">
              <h2 class="text-xs font-geist-mono uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-500">
                Operating principles
              </h2>
              <ul class="grid gap-5 md:grid-cols-3">
                {
                  operatingPrinciples.map((principle) => (
                    <li class="space-y-2">
                      <h3 class="text-sm font-geist-mono font-semibold text-zinc-900 dark:text-zinc-50">
                        {principle.title}
                      </h3>
                      <p class="text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
                        {principle.description}
                      </p>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div
              class="dot-grid border-t border-accent/20 px-8 pb-10 pt-6 dark:border-zinc-800 md:px-16 md:pb-12 md:pt-7"
              data-tech-chip-region
            >
              <ul class="flex flex-wrap justify-center gap-2">
                {
                  technicalRange.map((skill) => (
                    <li class="relative">
                      <span
                        tabindex={skill.detail ? "0" : undefined}
                        aria-describedby={skill.detail ? `skill-${skill.label.toLowerCase().replaceAll(" ", "-")}` : undefined}
                        data-skill-popover-trigger={skill.detail ? true : undefined}
                        data-tech-chip
                        class:list={[
                          "tech-chip inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-geist-mono border border-accent/20 dark:border-zinc-800 text-zinc-600 dark:text-zinc-300 bg-ivory/90 dark:bg-zinc-950/90",
                          skill.detail &&
                            "skill-popover-trigger cursor-help outline-none focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ivory dark:focus-visible:ring-offset-zinc-950",
                        ]}
                      >
                        {skill.label}
                        {skill.detail && <i class="ph ph-info text-[13px] text-zinc-400 dark:text-zinc-500" />}
                      </span>
                      {skill.detail && (
                        <span
                          id={`skill-${skill.label.toLowerCase().replaceAll(" ", "-")}`}
                          role="tooltip"
                          data-skill-popover
                          class="skill-popover pointer-events-none fixed z-50 w-max max-w-48 rounded border border-accent/20 dark:border-zinc-700 bg-ivory px-3 py-2 text-xs font-geist-mono leading-relaxed text-zinc-700 opacity-0 shadow-lg shadow-zinc-900/10 transition duration-150 ease-out dark:bg-zinc-950 dark:text-zinc-300 dark:shadow-black/40"
                        >
                          {skill.detail}
                        </span>
                      )}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div class="site-right-rail hidden md:flex" />
        </div>
      </section>

      <div
        class="relative z-10 flex h-0 md:divide-x divide-accent/20 dark:divide-zinc-800"
        aria-label="Work history detail level"
      >
        <div class="site-left-rail hidden md:flex" />
        <div class="max-w-4xl w-full flex justify-center">
          <div
            class:list={[
              "work-view-control inline-flex h-9 -translate-y-1/2 items-center border border-accent/20 bg-ivory p-1 shadow-sm shadow-zinc-900/5 dark:border-zinc-800 dark:bg-zinc-950 dark:shadow-black/30",
              "is-initial-render",
              isInitiallyDetailed && "is-detailed",
            ]}
            data-work-view-control
          >
            <button
              type="button"
              class:list={[
                "work-view-toggle relative z-10 inline-flex h-7 min-w-20 items-center justify-center px-3 text-xs font-geist-mono font-medium transition-colors",
                !isInitiallyDetailed && "is-active",
              ]}
              aria-pressed={isInitiallyDetailed ? "false" : "true"}
              data-work-view-toggle
              data-work-view="minimal"
            >
              Minimal
            </button>
            <button
              type="button"
              class:list={[
                "work-view-toggle relative z-10 inline-flex h-7 min-w-20 items-center justify-center px-3 text-xs font-geist-mono font-medium transition-colors",
                isInitiallyDetailed && "is-active",
              ]}
              aria-pressed={isInitiallyDetailed ? "true" : "false"}
              data-work-view-toggle
              data-work-view="detailed"
            >
              Detailed
            </button>
          </div>
        </div>
        <div class="site-right-rail hidden md:flex" />
      </div>

      {/* Jobs Grid */}
      <div
        id="work-history"
        class:list={[
          "work-history w-full flex flex-col space-y-0 divide-y divide-accent/20 dark:divide-zinc-800 border-b border-accent/20 dark:border-zinc-800",
          "is-initial-render",
          isInitiallyDetailed && "is-detailed",
        ]}
        data-work-history
      >
        {
          jobs.map((job, index) => {
            const jobExpanded = isJobInitiallyExpanded(job.company);

            return (
              <div
                id={`work-${getWorkSlug(job.company)}`}
                class="scroll-mt-24 flex flex-col md:flex-row md:divide-x divide-accent/20 dark:divide-zinc-800 relative"
              >
                <div class="site-left-rail hidden md:flex" />
                <div
                  class:list={[
                    "work-row max-w-4xl w-full px-8 md:px-16 py-4 md:py-6 group relative",
                    jobExpanded && "is-expanded",
                  ]}
                >
                  <div class="flex gap-6">
                    {/* Logo */}
                    <div class="flex-none">
                      <div class="relative w-12 h-12 squircle overflow-hidden bg-zinc-100 dark:bg-zinc-900 ring-1 ring-zinc-200 dark:ring-zinc-800 flex items-center justify-center">
                        <img
                          src={(job.img as any).src || job.img}
                          alt={job.company}
                          class:list={[
                            "w-full h-full transition-all ease-in duration-300",
                            job.logoTreatment === "contain"
                              ? "object-contain p-2 dark:invert"
                              : "object-cover",
                          ]}
                        />
                      </div>
                    </div>

                    {/* Content */}
                    <div class="flex-1 min-w-0">
                      <div class="space-y-2">
                        <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2">
                          <div class="space-y-1">
                            <h3 class="text-base font-geist-mono font-bold text-zinc-900 dark:text-zinc-50 group-hover:text-accent dark:group-hover:text-accent transition-colors ease-in duration-300">
                              {job.company}
                              {job.extraInfo && (
                                <span class="text-xs font-normal text-zinc-500 dark:text-zinc-400 ml-2">
                                  ({job.extraInfo})
                                </span>
                              )}
                            </h3>
                            <p class="text-xs font-geist-mono text-zinc-700 dark:text-zinc-300">
                              {job.role}
                            </p>
                          </div>
                          <time class="text-xs font-geist-mono uppercase tracking-wide text-zinc-500 dark:text-zinc-500 whitespace-nowrap">
                            {formatDateRange(job.startDate, job.endDate, index)}
                          </time>
                        </div>
                        {(job.summary || job.highlights || job.technologies) && (
                          <div
                            id={`work-detail-${index}`}
                            class:list={["work-detail", jobExpanded && "is-expanded"]}
                            data-work-detail
                            style={`--detail-panel-delay: ${getDetailPanelDelay(index)}`}
                          >
                            <div class="work-detail-inner space-y-2">
                              {job.summary && (
                                <p
                                  class="work-detail-item text-sm leading-relaxed text-zinc-700 dark:text-zinc-300"
                                  style={`--detail-delay: ${getDetailItemDelay(index, 0)}`}
                                >
                                  {job.summary}
                                </p>
                              )}
                              {job.highlights && (
                                <ul class="space-y-2">
                                  {job.highlights.map((highlight, highlightIndex) => (
                                    <li
                                      class="work-detail-item text-sm leading-relaxed text-zinc-600 dark:text-zinc-400"
                                      style={`--detail-delay: ${getDetailItemDelay(index, getDetailLineIndex(Boolean(job.summary), highlightIndex))}`}
                                    >
                                      {highlight}
                                    </li>
                                  ))}
                                </ul>
                              )}
                              {job.technologies && (
                                <p
                                  class="work-detail-item text-xs font-geist-mono leading-6 text-zinc-500 dark:text-zinc-500"
                                  style={`--detail-delay: ${getDetailItemDelay(index, getDetailLineIndex(Boolean(job.summary), job.highlights?.length ?? 0))}`}
                                >
                                  {job.technologies.join(" / ")}
                                </p>
                              )}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                  {(job.summary || job.highlights || job.technologies) && (
                    <button
                      type="button"
                      class="work-row-more absolute bottom-0 left-1/2 z-10 px-5 py-3 text-xs font-geist-mono text-zinc-500 hover:text-accent focus-visible:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ivory dark:text-zinc-500 dark:hover:text-accent dark:focus-visible:text-accent dark:focus-visible:ring-offset-zinc-950"
                      aria-expanded={jobExpanded ? "true" : "false"}
                      aria-controls={`work-detail-${index}`}
                      data-work-row-toggle
                    >
                      {jobExpanded ? "Less" : "More"}
                    </button>
                  )}
                  <Frame corners={index === jobs.length - 1 ? ["all"] : ["top"]} />
                </div>
                <div class="site-right-rail hidden md:flex" />
              </div>
            );
          })
        }
      </div>

      {/* Fill remaining space with vertical borders */}
      <div class="flex-1 flex md:divide-x divide-accent/20 dark:divide-zinc-800">
        <div class="site-left-rail hidden md:flex" />
        <div class="max-w-4xl w-full" />
        <div class="site-right-rail hidden md:flex" />
      </div>
    </article>
  </Page>

  <style>
    .work-view-control {
      position: relative;
      isolation: isolate;
    }

    .work-view-control::before {
      content: "";
      position: absolute;
      z-index: 0;
      top: 0.25rem;
      bottom: 0.25rem;
      left: 0.25rem;
      width: calc((100% - 0.5rem) / 2);
      background: color-mix(in srgb, var(--color-accent) 24%, transparent);
      transition:
        transform 180ms ease,
        background-color 180ms ease;
    }

    .work-view-control.is-detailed::before {
      transform: translateX(100%);
    }

    .work-view-control.is-initial-render::before {
      transition: none;
    }

    .work-view-toggle {
      color: rgb(82 82 91);
    }

    .work-view-toggle:hover {
      color: var(--color-accent);
    }

    .work-view-toggle.is-active {
      color: rgb(39 39 42);
    }

    :global(.dark) .work-view-control::before {
      background: color-mix(in srgb, var(--color-accent) 28%, var(--color-zinc-900));
    }

    :global(.dark) .work-view-toggle {
      color: rgb(212 212 216);
    }

    :global(.dark) .work-view-toggle:hover {
      color: var(--color-accent);
    }

    :global(.dark) .work-view-toggle.is-active {
      color: rgb(244 244 245);
    }

    .work-detail {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
    }

    .work-detail-inner {
      min-height: 0;
      overflow: hidden;
    }

    .work-detail-item {
      opacity: 0;
      transform: translateY(4px) scale(0.98);
      transform-origin: top left;
    }

    .work-detail.is-expanded {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .work-detail.is-expanded .work-detail-inner {
      padding-top: 0.25rem;
    }

    .work-detail.is-expanded .work-detail-item {
      opacity: 1;
      transform: none;
    }

    .work-history.is-animating .work-detail {
      transition:
        grid-template-rows 140ms ease,
        opacity 90ms ease;
    }

    .work-history.is-animating .work-detail-inner {
      transition: padding-top 140ms ease;
    }

    .work-history.is-animating .work-detail.is-expanded {
      transition:
        grid-template-rows 260ms ease-out,
        opacity 120ms ease-out;
      transition-delay: var(--detail-panel-delay, 0ms);
    }

    .work-history.is-animating .work-detail.is-expanded .work-detail-inner {
      transition-delay: var(--detail-panel-delay, 0ms);
    }

    .work-history.is-animating .work-detail.is-expanded .work-detail-item {
      animation: detail-item-in 260ms ease-out both;
      animation-delay: var(--detail-delay, 0ms);
    }

    .work-detail.is-animating {
      transition:
        grid-template-rows 180ms ease,
        opacity 120ms ease;
    }

    .work-detail.is-animating .work-detail-inner {
      transition: padding-top 180ms ease;
    }

    .work-detail.is-animating .work-detail-item {
      transition:
        opacity 120ms ease,
        transform 120ms ease;
    }

    .work-detail.is-animating.is-expanded {
      transition:
        grid-template-rows 220ms ease-out,
        opacity 120ms ease-out;
      transition-delay: 0ms;
    }

    .work-detail.is-animating.is-expanded .work-detail-inner {
      transition-delay: 0ms;
    }

    .work-detail.is-animating.is-expanded .work-detail-item {
      animation: detail-item-in 220ms ease-out both;
      animation-delay: 0ms;
    }

    .work-history.is-initial-render .work-detail,
    .work-history.is-initial-render .work-detail-inner,
    .work-history.is-initial-render .work-detail.is-expanded,
    .work-history.is-initial-render .work-detail.is-expanded .work-detail-inner,
    .work-history.is-initial-render .work-detail-item {
      transition: none;
      transition-delay: 0ms;
    }

    .work-history.is-initial-render .work-detail.is-expanded .work-detail-item {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .work-row-more {
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%) scale(1);
      transition:
        opacity 150ms ease,
        color 150ms ease;
      transform-origin: center;
    }

    .work-row:hover .work-row-more,
    .work-row-more:focus-visible,
    .work-row.is-expanded .work-row-more {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) scale(1.06);
      transition:
        opacity 150ms ease,
        transform 150ms ease,
        color 150ms ease;
    }

    .work-history.is-detailed .work-row-more {
      display: none;
    }

    .work-history:not(.is-detailed) .work-row.is-expanded {
      padding-bottom: 3rem;
    }

    .tech-chip {
      user-select: none;
      transform: translate(var(--chip-x, 0), var(--chip-y, 0)) scale(var(--chip-scale, 1));
      transition:
        transform 140ms ease,
        border-color 150ms ease,
        color 150ms ease;
      will-change: transform;
    }

    .skill-popover::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -5px;
      width: 9px;
      height: 9px;
      transform: translateX(-50%) rotate(45deg);
      border-right: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
      border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
      background: inherit;
    }

    .skill-popover-trigger:hover + .skill-popover,
    .skill-popover-trigger:focus-visible + .skill-popover {
      opacity: 1;
      transform: translate(-50%, calc(-100% - 12px));
    }

    .skill-popover {
      left: var(--tooltip-x, 50vw);
      top: var(--tooltip-y, 50vh);
      transform: translate(-50%, calc(-100% - 8px));
    }

    @keyframes detail-item-in {
      0% {
        opacity: 0;
        transform: translateY(5px) scale(0.98);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .work-detail,
      .work-view-control::before,
      .tech-chip,
      .work-detail.is-expanded,
      .work-history.is-animating .work-detail,
      .work-history.is-animating .work-detail.is-expanded,
      .work-detail.is-animating,
      .work-detail.is-animating.is-expanded,
      .work-detail-item,
      .work-detail.is-expanded .work-detail-item,
      .work-history.is-animating .work-detail.is-expanded .work-detail-item,
      .work-detail.is-animating.is-expanded .work-detail-item {
        animation: none;
        transition: none;
      }

      .work-detail.is-expanded .work-detail-item {
        opacity: 1;
        transform: none;
      }
    }
  </style>

  <script>
    const WORK_VIEW_STORAGE_KEY = "work-view";
    const WORK_VIEW_COOKIE_NAME = "work-view";
    const WORK_VIEW_ANIMATION_MS = 1300;
    const WORK_DETAIL_ANIMATION_MS = 360;

    function getRenderedWorkView() {
      return document
        .querySelector<HTMLElement>("[data-work-view-control]")
        ?.classList.contains("is-detailed")
        ? "detailed"
        : "minimal";
    }

    function getStoredWorkView() {
      return localStorage.getItem(WORK_VIEW_STORAGE_KEY);
    }

    function persistWorkViewPreference(view: "minimal" | "detailed") {
      localStorage.setItem(WORK_VIEW_STORAGE_KEY, view);
      document.cookie = `${WORK_VIEW_COOKIE_NAME}=${view}; Path=/; Max-Age=31536000; SameSite=Lax`;
    }

    function animateWorkHistory(histories: HTMLElement[]) {
      histories.forEach((history) => {
        history.classList.add("is-animating");
        window.setTimeout(() => {
          history.classList.remove("is-animating");
        }, WORK_VIEW_ANIMATION_MS);
      });
    }

    function animateWorkDetail(detail: HTMLElement) {
      detail.classList.add("is-animating");
      window.setTimeout(() => {
        detail.classList.remove("is-animating");
      }, WORK_DETAIL_ANIMATION_MS);
    }

    function initWorkViewToggle() {
      const toggles = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-work-view-toggle]"),
      );
      const details = Array.from(document.querySelectorAll<HTMLElement>("[data-work-detail]"));
      const controls = Array.from(
        document.querySelectorAll<HTMLElement>("[data-work-view-control]"),
      );
      const histories = Array.from(document.querySelectorAll<HTMLElement>("[data-work-history]"));
      const rowToggles = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-work-row-toggle]"),
      );
      const rows = Array.from(document.querySelectorAll<HTMLElement>(".work-row"));

      if (toggles.length === 0 || details.length === 0) return;
      if (toggles[0]?.dataset.workViewBound === "true") return;

      const setExpanded = (expanded: boolean, persist = true, animate = false) => {
        if (animate && expanded) {
          animateWorkHistory(histories);
        }

        details.forEach((detail) => {
          detail.classList.toggle("is-expanded", expanded);
        });

        controls.forEach((control) => {
          control.classList.toggle("is-detailed", expanded);
        });

        histories.forEach((history) => {
          history.classList.toggle("is-detailed", expanded);
        });

        rowToggles.forEach((rowToggle) => {
          rowToggle.setAttribute("aria-expanded", String(expanded));
          rowToggle.textContent = expanded ? "Less" : "More";
        });

        rows.forEach((row) => {
          row.classList.toggle("is-expanded", expanded);
        });

        toggles.forEach((toggle) => {
          const active = toggle.dataset.workView === (expanded ? "detailed" : "minimal");
          toggle.classList.toggle("is-active", active);
          toggle.setAttribute("aria-pressed", String(active));
        });

        if (persist) {
          persistWorkViewPreference(expanded ? "detailed" : "minimal");
        }
      };

      const renderedWorkView = getRenderedWorkView();
      const storedWorkView = getStoredWorkView();

      if (storedWorkView === "detailed" && renderedWorkView !== "detailed") {
        setExpanded(true, true);
      } else if (!storedWorkView) {
        persistWorkViewPreference(renderedWorkView);
      }

      window.requestAnimationFrame(() => {
        controls.forEach((control) => {
          control.classList.remove("is-initial-render");
        });

        histories.forEach((history) => {
          history.classList.remove("is-initial-render");
        });
      });

      toggles.forEach((toggle) => {
        toggle.dataset.workViewBound = "true";
        toggle.addEventListener("click", () => {
          const expanded = toggle.dataset.workView === "detailed";
          setExpanded(expanded, true, expanded);
        });
      });
    }

    initWorkViewToggle();

    function initWorkRowToggles() {
      const rowToggles = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-work-row-toggle]"),
      );

      rowToggles.forEach((rowToggle) => {
        if (rowToggle.dataset.workRowToggleBound === "true") return;

        const detailId = rowToggle.getAttribute("aria-controls");
        const detail = detailId ? document.getElementById(detailId) : null;
        if (!detail) return;

        rowToggle.dataset.workRowToggleBound = "true";
        rowToggle.addEventListener("click", () => {
          const expanded = !detail.classList.contains("is-expanded");
          const row = rowToggle.closest<HTMLElement>(".work-row");

          animateWorkDetail(detail);

          detail.classList.toggle("is-expanded", expanded);
          row?.classList.toggle("is-expanded", expanded);
          rowToggle.setAttribute("aria-expanded", String(expanded));
          rowToggle.textContent = expanded ? "Less" : "More";
        });
      });
    }

    initWorkRowToggles();

    function initSkillPopovers() {
      const triggers = Array.from(
        document.querySelectorAll<HTMLElement>("[data-skill-popover-trigger]"),
      );

      triggers.forEach((trigger) => {
        if (trigger.dataset.skillPopoverBound === "true") return;

        const popover = trigger.nextElementSibling as HTMLElement | null;
        if (!popover?.matches("[data-skill-popover]")) return;

        const setPosition = (x: number, y: number) => {
          popover.style.setProperty("--tooltip-x", `${x}px`);
          popover.style.setProperty("--tooltip-y", `${y}px`);
        };

        trigger.dataset.skillPopoverBound = "true";
        trigger.addEventListener("pointerenter", (event) => {
          setPosition(event.clientX, event.clientY);
        });
        trigger.addEventListener("pointermove", (event) => {
          setPosition(event.clientX, event.clientY);
        });
        trigger.addEventListener("focus", () => {
          const rect = trigger.getBoundingClientRect();
          setPosition(rect.left + rect.width / 2, rect.top);
        });
      });
    }

    initSkillPopovers();

    function initTechChipMagnet() {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const regions = Array.from(
        document.querySelectorAll<HTMLElement>("[data-tech-chip-region]"),
      );

      regions.forEach((region) => {
        if (region.dataset.techChipRegionBound === "true") return;

        const chips = Array.from(region.querySelectorAll<HTMLElement>("[data-tech-chip]"));
        if (chips.length === 0) return;

        let frame = 0;
        let pointerX = 0;
        let pointerY = 0;

        const resetChips = () => {
          chips.forEach((chip) => {
            chip.style.removeProperty("--chip-x");
            chip.style.removeProperty("--chip-y");
            chip.style.removeProperty("--chip-scale");
          });
        };

        const updateChips = () => {
          frame = 0;

          chips.forEach((chip) => {
            const rect = chip.getBoundingClientRect();
            const nearestX = Math.max(rect.left, Math.min(pointerX, rect.right));
            const nearestY = Math.max(rect.top, Math.min(pointerY, rect.bottom));
            const edgeDistance = Math.hypot(pointerX - nearestX, pointerY - nearestY);

            if (edgeDistance > 10) {
              chip.style.removeProperty("--chip-x");
              chip.style.removeProperty("--chip-y");
              chip.style.removeProperty("--chip-scale");
              return;
            }

            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const offsetX = pointerX - centerX;
            const offsetY = pointerY - centerY;
            const distanceFromCenter = Math.max(Math.hypot(offsetX, offsetY), 1);
            const strength = 1 - edgeDistance / 10;
            const pull = 4 * strength;

            chip.style.setProperty("--chip-x", `${(offsetX / distanceFromCenter) * pull}px`);
            chip.style.setProperty("--chip-y", `${(offsetY / distanceFromCenter) * pull}px`);
            chip.style.setProperty("--chip-scale", `${1 + 0.025 * strength}`);
          });
        };

        region.dataset.techChipRegionBound = "true";
        region.addEventListener("pointermove", (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;

          if (frame === 0) {
            frame = window.requestAnimationFrame(updateChips);
          }
        });
        region.addEventListener("pointerleave", () => {
          if (frame !== 0) {
            window.cancelAnimationFrame(frame);
            frame = 0;
          }

          resetChips();
        });
      });
    }

    initTechChipMagnet();
    document.addEventListener("astro:page-load", () => {
      initWorkViewToggle();
      initWorkRowToggles();
      initSkillPopovers();
      initTechChipMagnet();
    });
  </script>
</Base>
