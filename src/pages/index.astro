---
export const prerender = true;

import Base from "../layouts/base-layout.astro";
import Page from "../components/page.astro";
import HomepageBlog from "../components/homepage-blog.astro";
import { DecodeText } from "../components/decode-text";
import { links } from "../../links";
import ExternalLink from "src/components/external-link.astro";
import PageHeader from "src/components/page-header.astro";
---

<Base>
  <Page>
    <article
      class="w-full border-l border-r border-orange/20 dark:border-zinc-800"
    >
      {/* Hero Section */}
      <PageHeader>
        <h1
          slot="title"
          class="font-geist-mono text-4xl font-bold leading-tight tracking-tight text-zinc-900 dark:text-zinc-50 md:text-5xl"
        >
          Making{" "}
          <DecodeText
            client:load
            value="complex workflows"
            decodeByWord={true}
            className="inline"
          />
          {" "}feel effortless.
        </h1>
        <div class="space-y-6" slot="description">
          <p
            class="max-w-2xl font-geist-mono text-lg leading-relaxed text-zinc-600 dark:text-zinc-400 md:text-xl"
          >
            Senior Full‑Stack Engineer in San Francisco. <br />React,
            TypeScript, DX tooling, AI UI, Eng.&nbsp;Mentorship.
          </p>
        </div>
      </PageHeader>

      {/* Social Links Section */}
      <div
        class="hidden w-full divide-x divide-orange/20 border-b border-orange/20 dark:divide-zinc-800 dark:border-zinc-800 md:flex"
      >
        <div class="flex-1 p-4 md:p-8"></div>
        <div class="w-full max-w-4xl">
          <ul class="flex px-16">
            {
              links.map(([href, label, icon]) => (
                <li class="group border-r border-orange/20 transition-colors first:border-l hover:bg-orange/5 dark:border-zinc-800">
                  <ExternalLink
                    href={href}
                    icon={icon}
                    class="block p-8 font-geist-mono text-sm font-medium text-zinc-600 transition-colors hover:text-orange dark:text-zinc-400 dark:hover:text-orange"
                  >
                    {label}
                  </ExternalLink>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex-1 p-4 md:p-8"></div>
      </div>

      {/* Social Links Section Mobile */}
      <div
        class="w-full border-b border-orange/20 dark:border-zinc-800 md:hidden"
      >
        <ul class="flex divide-x divide-orange/20 dark:divide-zinc-800">
          {
            links.map(([href, label]) => (
              <li class="flex flex-1 items-center justify-center py-6">
                <a
                  href={href}
                  class="font-geist-mono text-sm font-medium text-zinc-600 transition-colors hover:text-orange dark:text-zinc-400 dark:hover:text-orange"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <HomepageBlog />
    </article>
  </Page>
</Base>
