---
export const prerender = true;

import Base from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import HomepageBlog from "../components/HomepageBlog.astro";
import { DecodeText } from "../components/DecodeText";
import { links } from "../../navigationLinks";
import ExternalLink from "src/components/ExternalLink.astro";
import PageHeader from "src/components/PageHeader.astro";

const nowBuilding = [
  {
    href: "https://usesumi.ink",
    urlLabel: "usesumi.ink",
    label: "Sumi",
    description: "Studio operations software for tattoo artists",
  },
  {
    href: "https://github.com/nickradford/savoix",
    urlLabel: "github.com/nickradford/savoix",
    label: "Savoix",
    description: "A script recording and transcription app",
  },
];
---

<Base>
  <Page>
    <article class="border-l border-r border-orange/20 dark:border-zinc-800 w-full">
      {/* Hero Section */}
      <PageHeader>
        <h1
          slot="title"
          class="text-4xl md:text-5xl font-geist-mono font-bold tracking-tight leading-tight text-zinc-900 dark:text-zinc-50"
        >
          Making{" "}
          <DecodeText
            client:load
            value="complex workflows"
            decodeByWord={true}
            className="inline"
          />
          {" "}feel effortless.
        </h1>
        <div class="space-y-6" slot="description">
          <p
            class="font-geist-mono text-lg md:text-xl leading-relaxed text-zinc-600 dark:text-zinc-400 max-w-2xl"
          >
            Senior Full‑Stack Engineer in San Francisco. <br />React, TypeScript, DX tooling, AI UI,
            Eng.&nbsp;Mentorship.
          </p>
          <div
            class="max-w-3xl font-geist-mono text-sm leading-7 text-stone-600 dark:text-zinc-400"
            aria-label="Now building"
          >
            <p class="mb-1 text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-500">
              Now building
            </p>
            <ul class="space-y-1">
              {
                nowBuilding.map((project) => (
                  <li>
                    <a
                      href={project.href}
                      class="group inline hover:bg-orange/5 dark:hover:bg-zinc-900/60"
                    ><span class="text-stone-400 dark:text-zinc-500">[</span><span class="text-orange-600 dark:text-orange-400 group-hover:text-orange-500 dark:group-hover:text-orange-300 group-hover:underline">{project.urlLabel}</span><span class="text-stone-400 dark:text-zinc-500">]({project.label})</span></a>
                    <span class="text-stone-400 dark:text-zinc-600"> - </span>
                    <span>{project.description}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </PageHeader>

      {/* Social Links Section */}
      <div
        class="w-full border-b border-orange/20 dark:border-zinc-800 hidden md:flex divide-x divide-orange/20 dark:divide-zinc-800"
      >
        <div class="flex-1"></div>
        <div class="max-w-4xl w-full dot-grid">
          <ul class="flex px-16">
            {
              links.map(([href, label, icon]) => (
                <li class="group first:border-l dark:border-zinc-800 border-r border-orange/20 bg-ivory dark:bg-zinc-950 hover:bg-[#fff7e8] dark:hover:bg-zinc-900 transition-colors">
                  <ExternalLink
                    href={href}
                    icon={icon}
                    class="block text-sm p-8 font-geist-mono font-medium text-zinc-600 hover:text-orange dark:text-zinc-400 dark:hover:text-orange transition-colors"
                  >
                    {label}
                  </ExternalLink>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex-1"></div>
      </div>

      {/* Social Links Section Mobile */}
      <div class="w-full border-b border-orange/20 dark:border-zinc-800 md:hidden">
        <ul class="flex divide-x dark:divide-zinc-800 divide-orange/20">
          {
            links.map(([href, label]) => (
              <li class="flex-1 py-6 items-center flex justify-center">
                <a
                  href={href}
                  class="text-sm font-geist-mono font-medium text-zinc-600 hover:text-orange dark:text-zinc-400 dark:hover:text-orange transition-colors"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <HomepageBlog />
    </article>
  </Page>
</Base>
