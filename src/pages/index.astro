---
export const prerender = true;

import Base from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import HomepageBlog from "../components/HomepageBlog.astro";
import { DecodeText } from "../components/DecodeText";
import { links } from "../../navigationLinks";
import ExternalLink from "src/components/ExternalLink.astro";
import PageHeader from "src/components/PageHeader.astro";

const nowBuilding = [
  {
    href: "https://usesumi.ink",
    urlLabel: "usesumi.ink",
    label: "Sumi",
    description: "CRM, booking, scheduling, payments, and onboarding for tattoo studios",
  },
  {
    href: "https://github.com/nickradford/savoix",
    urlLabel: "github.com/nickradford/savoix",
    label: "Savoix",
    description: "A script recording and transcription app",
  },
];
---

<Base description="Staff Product Engineer in San Francisco building full-stack SaaS, internal tools, design systems, and developer platforms.">
  <Page>
    <article class="border-l border-r border-accent/20 dark:border-zinc-800 w-full">
      {/* Hero Section */}
      <PageHeader>
        <h1
          slot="title"
          class="text-3xl sm:text-4xl md:text-5xl font-geist-mono font-bold tracking-tight leading-tight text-zinc-900 dark:text-zinc-50"
        >
          Making{" "}
          <DecodeText
            client:load
            value="complex workflows"
            decodeByWord={true}
            className="inline"
          />
          {" "}feel effortless.
        </h1>
        <div class="space-y-6" slot="description">
          <p
            class="font-geist-mono text-base sm:text-lg md:text-xl leading-relaxed text-zinc-600 dark:text-zinc-400 max-w-2xl"
          >
            Staff Product Engineer in San&nbsp;Francisco. <br />TypeScript, React, Node.js,
            PostgreSQL, Cloudflare, AI-assisted workflows.
          </p>
          <div
            class="max-w-3xl font-geist-mono text-xs sm:text-sm leading-6 sm:leading-7 text-stone-600 dark:text-zinc-400"
            aria-label="Now building"
          >
            <p class="mb-1 text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-500">
              Now building
            </p>
            <ul class="space-y-1">
              {
                nowBuilding.map((project) => (
                  <li>
                    <a
                      href={project.href}
                      class="group inline hover:bg-accent/5 dark:hover:bg-zinc-900/60"
                    ><span class="text-stone-400 dark:text-zinc-500">[</span><span class="text-accent dark:text-accent group-hover:text-accent dark:group-hover:text-accent group-hover:underline [overflow-wrap:anywhere]">{project.urlLabel}</span><span class="text-stone-400 dark:text-zinc-500">]({project.label})</span></a>
                    <span class="text-stone-400 dark:text-zinc-600"> - </span>
                    <span>{project.description}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </PageHeader>

      {/* Social Links Section */}
      <div
        class="w-full border-b border-accent/20 dark:border-zinc-800 hidden md:flex divide-x divide-accent/20 dark:divide-zinc-800"
      >
        <div class="site-left-rail"></div>
        <div class="dot-grid max-w-4xl w-full">
          <nav class="flex divide-x divide-accent/20 dark:divide-zinc-800">
            <div class="w-8 shrink-0 md:w-16" aria-hidden="true"></div>
            {
              links.map(([href, label, icon, download]) => (
                <ExternalLink
                  href={href}
                  icon={icon}
                  download={download}
                  class="block bg-ivory px-8 py-6 text-sm font-geist-mono font-medium text-zinc-600 transition-colors hover:text-accent dark:bg-zinc-950 dark:text-zinc-400 dark:hover:text-accent md:px-4"
                >
                  {label}
                </ExternalLink>
              ))
            }
            <div class="w-8 shrink-0 md:w-16" aria-hidden="true"></div>
          </nav>
        </div>
        <div class="site-right-rail"></div>
      </div>

      {/* Social Links Section Mobile */}
      <div class="w-full border-b border-accent/20 dark:border-zinc-800 md:hidden">
        <ul class="flex divide-x dark:divide-zinc-800 divide-accent/20">
          {
            links.map(([href, label, , download]) => (
              <li class="flex-1 py-6 items-center flex justify-center">
                <a
                  href={href}
                  download={download}
                  class="text-sm font-geist-mono font-medium text-zinc-600 hover:text-accent dark:text-zinc-400 dark:hover:text-accent transition-colors"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <HomepageBlog />
    </article>
  </Page>
</Base>
