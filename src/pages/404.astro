---
export const prerender = true;

import Base from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import { DecodeText } from "../components/DecodeText";

const attemptedPath = Astro.url.pathname;

const recoveryLinks = [
  { href: "/", label: "Home", detail: "Back to the main landing page." },
  { href: "/blog", label: "Writing", detail: "Latest posts, notes, and changelogs." },
  { href: "/work", label: "Work", detail: "Experience, roles, and projects." },
  { href: "/search", label: "Search", detail: "Find content by keyword." },
  { href: "/links", label: "Links", detail: "Other people's writing that inspires me." },
];
---

<Base
  title="404 | Nick Radford"
  description="The page you were looking for does not exist."
  noindex={true}
>
  <Page class="min-h-[calc(100vh-64px)]">
    <article class="w-full flex-1 flex flex-col border-l border-r border-orange/20 dark:border-zinc-800">
      <section class="relative border-b border-orange/20 dark:border-zinc-800 overflow-hidden">
        <div class="relative flex flex-col md:flex-row md:divide-x divide-orange/20 dark:divide-zinc-800">
          <div class="hidden md:flex flex-1" />
          <div class="max-w-4xl w-full px-8 md:px-16 py-10 md:py-14 relative">
            <p class="font-geist-mono text-xs uppercase tracking-[0.22em] text-zinc-500 dark:text-zinc-400">
              Error 404 • Not Found
            </p>
            <div class="mt-6">
                <h1 class="text-4xl md:text-5xl font-geist-mono font-bold tracking-tight leading-tight text-zinc-900 dark:text-zinc-50">
                  <DecodeText client:load value="that route does not exist" decodeByWord/>
                </h1>


                <div class="mt-7 flex flex-wrap gap-3">
                  <a
                    href="/"
                    class="inline-flex items-center gap-2 px-5 py-3 bg-orange text-zinc-950 font-geist-mono text-sm font-medium hover:bg-orange/90 transition-colors"
                  >
                    Return home <i class="ph ph-house"></i>
                  </a>
                </div>
            </div>
          </div>
          <div class="hidden md:flex flex-1" />
        </div>
      </section>

      <section class="w-full border-orange/20 dark:border-zinc-800 relative overflow-hidden">
        <div class="pointer-events-none absolute inset-0"></div>
        <div class="flex flex-col md:flex-row ">
          <div class="hidden md:flex flex-1" />
          <div class="max-w-4xl w-full py-8 relative text-[10px]">
            <div class="relative font-geist-mono">
              <div class="relative bg-ivory dark:bg-zinc-950 border border-orange/20 dark:border-zinc-800 overflow-hidden shadow-orange/10 dark:shadow-zinc-100/5 shadow-xl">
                <div class="flex items-center gap-1.5 px-3 py-2 bg-orange/5 dark:bg-zinc-900/50 border-b border-orange/20 dark:border-zinc-800">
                  <div class="size-2 rounded-full bg-zinc-400 dark:bg-zinc-700"></div>
                  <div class="size-2 rounded-full bg-zinc-400 dark:bg-zinc-700"></div>
                  <div class="size-2 rounded-full bg-zinc-400 dark:bg-zinc-700"></div>
                  <span class="ml-1.5 text-xs text-zinc-500">404.log</span>
                </div>
                <div id="terminal-body" class="p-4 md:px-6 font-geist-mono text-sm leading-7 overflow-x-auto">
                  <div class="terminal-line flex" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">1</span>
                    <span class="terminal-content"><span class="text-emerald-600 dark:text-emerald-400 font-semibold">GET</span> <span class="text-orange-600 dark:text-orange-400">{attemptedPath}</span> <span class="text-stone-400 dark:text-zinc-500">HTTP/1.1</span></span>
                  </div>
                  <div class="terminal-line flex" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">2</span>
                    <span class="terminal-content text-stone-600 dark:text-zinc-400"><span class="text-stone-500">Host:</span> {Astro.url.host}</span>
                  </div>
                  <div class="terminal-line flex" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">3</span>
                    <span class="terminal-content text-stone-600 dark:text-zinc-400"><span class="text-stone-500">User-Agent:</span> Mozilla/5.0 (compatible; LostBot/1.0)</span>
                  </div>
                  <div class="terminal-line flex" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">4</span>
                    <span class="terminal-content text-stone-600 dark:text-zinc-400"><span class="text-stone-500">Accept:</span> text/html,application/xhtml+xml</span>
                  </div>
                  <div class="terminal-line flex my-2" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-300 dark:text-zinc-800 w-6 text-right mr-4 shrink-0"></span>
                    <span class="terminal-content text-stone-400 dark:text-zinc-700">---</span>
                  </div>
                  <div class="terminal-line flex" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">5</span>
                    <span class="terminal-content"><span class="text-stone-400 dark:text-zinc-500">HTTP/1.1</span> <span class="text-rose-600 dark:text-rose-400 font-semibold">404</span> <span class="text-stone-600 dark:text-zinc-400">Not Found</span></span>
                  </div>
                  <div class="terminal-line flex" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">6</span>
                    <span class="terminal-content text-stone-600 dark:text-zinc-400"><span class="text-stone-500">Content-Type:</span> text/md; charset=utf-8</span>
                  </div>
                  <div class="terminal-line flex my-1" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-300 dark:text-zinc-800 w-6 text-right mr-4 shrink-0"></span>
                    <span class="terminal-content"></span>
                  </div>
                  <div class="terminal-line flex" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">7</span>
                    <span class="terminal-content text-stone-700 dark:text-zinc-300 font-bold"># Known Good Routes</span>
                  </div>
                  <div class="terminal-line flex" style="height:0;overflow:hidden;">
                    <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">8</span>
                    <span class="terminal-content"></span>
                  </div>
                  {recoveryLinks.map((link, i) => (
                    <a href={link.href} class="terminal-line group flex hover:bg-orange/5 dark:hover:bg-zinc-900/50 -mx-6 px-6 cursor-pointer" style="height:0;overflow:hidden;">
                      <span class="select-none text-stone-400 dark:text-zinc-700 w-6 text-right mr-4 shrink-0">{9 + i}</span>
                      <span class="terminal-content text-stone-600 dark:text-zinc-400">- <span class="text-stone-400 dark:text-zinc-500">[</span><span class="text-orange-600 dark:text-orange-400 group-hover:underline group-hover:text-orange-500 dark:group-hover:text-orange-300">{link.label.toLowerCase()}</span><span class="text-stone-400 dark:text-zinc-500">]({link.href})</span> <span class="text-stone-400 dark:text-zinc-600">— {link.detail}</span></span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <div class="hidden md:flex flex-1" />
        </div>
      </section>
    </article>
  </Page>
</Base>

<script>
  let isBackNav = false;
  window.addEventListener("popstate", () => { isBackNav = true; });

  function showAll() {
    document.querySelectorAll<HTMLElement>(".terminal-line").forEach((l) => {
      l.style.height = "";
      l.style.overflow = "";
    });
  }

  function waapi(el: HTMLElement, keyframes: Keyframe[], ms: number, easing = "ease-out") {
    return el.animate(keyframes, { duration: ms, fill: "forwards", easing }).finished;
  }

  async function streamTerminal() {
    const lines = document.querySelectorAll<HTMLElement>(".terminal-line");
    if (!lines.length) return;

    // Skip animation on back-navigation or reduced motion
    if (
      isBackNav ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      showAll();
      return;
    }

    // Create blinking cursor element
    const cursor = document.createElement("span");
    cursor.textContent = "█";
    cursor.className = "terminal-cursor";

    // Measure each line's natural height while hidden
    const lineData: {
      el: HTMLElement;
      height: number;
      contentEl: HTMLElement | null;
      textLen: number;
    }[] = [];

    for (const line of lines) {
      line.style.height = "auto";
      line.style.overflow = "";
      const height = line.getBoundingClientRect().height;
      line.style.height = "0px";
      line.style.overflow = "hidden";

      const contentEl = line.querySelector<HTMLElement>(".terminal-content");
      const textLen = contentEl?.textContent?.length ?? 0;
      lineData.push({ el: line, height, contentEl, textLen });
    }

    const CHAR_SPEED = 0.015; // seconds per character
    const LATENCY_PAUSE = 0; // ms pause after request headers (server thinking)
    const LINE_GAP = 25; // ms gap between lines

    async function typeLine(entry: (typeof lineData)[number]) {
      const { el, height, contentEl, textLen } = entry;

      // Measure content width and clip BEFORE the line is visible
      let naturalWidth = 0;
      if (contentEl && textLen > 0) {
        el.style.height = "auto";
        el.style.overflow = "visible";
        naturalWidth = contentEl.getBoundingClientRect().width;
        el.style.height = "0px";
        el.style.overflow = "hidden";

        contentEl.style.display = "inline-block";
        contentEl.style.width = "0px";
        contentEl.style.overflow = "hidden";
        contentEl.style.whiteSpace = "nowrap";
        contentEl.style.verticalAlign = "top";
      }

      // Expand line height — content is already clipped
      await waapi(el, [{ height: "0px" }, { height: `${height}px` }], 60);
      el.style.height = "auto";
      el.style.overflow = "visible";

      // Reveal content character by character
      if (contentEl && textLen > 0) {
        contentEl.insertAdjacentElement("afterend", cursor);

        const duration = Math.max(80, textLen * CHAR_SPEED * 1000);
        await waapi(
          contentEl,
          [{ width: "0px" }, { width: `${naturalWidth}px` }],
          duration,
          "linear",
        );

        contentEl.style.display = "";
        contentEl.style.width = "";
        contentEl.style.overflow = "";
        contentEl.style.whiteSpace = "";
        contentEl.style.verticalAlign = "";
      } else {
        el.appendChild(cursor);
      }
    }

    // Initial delay
    await new Promise((r) => setTimeout(r, 350));

    // Phase 1: Request headers (lines 0–3)
    for (let i = 0; i <= 3; i++) {
      await typeLine(lineData[i]);
      await new Promise((r) => setTimeout(r, LINE_GAP));
    }

    // Phase 2: Latency pause
    await new Promise((r) => setTimeout(r, LATENCY_PAUSE));

    // Phase 3: Separator + response (lines 4–9)
    for (let i = 4; i <= 9; i++) {
      await typeLine(lineData[i]);
      await new Promise((r) => setTimeout(r, LINE_GAP));
    }

    await new Promise((r) => setTimeout(r, 150));

    // Phase 4: Recovery links (lines 10+)
    for (let i = 10; i < lineData.length; i++) {
      await typeLine(lineData[i]);
      await new Promise((r) => setTimeout(r, LINE_GAP));
    }

    cursor.remove();

    // Clean up inline styles
    for (const { el } of lineData) {
      el.style.height = "";
      el.style.overflow = "";
    }

  }

  document.addEventListener("astro:page-load", () => {
    if (document.querySelector("#terminal-body")) {
      streamTerminal();
    }
    isBackNav = false;
  });
</script>

<style>
  .route-wash {
    background:
      linear-gradient(100deg, rgb(255 149 0 / 0.1) 0%, transparent 34%),
      linear-gradient(260deg, rgb(255 149 0 / 0.1) 0%, transparent 36%);
  }

  :global(.dark) .route-wash {
    background:
      linear-gradient(100deg, var(--color-zinc-900) 0%, transparent 38%, transparent 62%, var(--color-zinc-900) 100%),
      linear-gradient(260deg, rgb(113 113 122 / 0.22) 0%, transparent 42%);
  }

  .terminal-cursor {
    display: inline-block;
    color: var(--color-orange);
    opacity: 0.7;
    animation: cursor-blink 0.7s step-end infinite;
    font-size: 0.875rem;
    line-height: 1.75rem;
    vertical-align: top;
    pointer-events: none;
    user-select: none;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .status-blip {
    animation: pulse 1.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.95;
    }
    50% {
      transform: scale(1.25);
      opacity: 0.5;
    }
  }
</style>
