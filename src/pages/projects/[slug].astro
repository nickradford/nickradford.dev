---
import Base from "../../layouts/BaseLayout.astro";
import Page from "../../components/Page.astro";
import BackButton from "../../components/BackButton.astro";
import ImageGallery from "src/components/mdx/ImageGallery.astro";
import { DecodeText } from "../../components/DecodeText";
import ExternalLink from "../../components/ExternalLink.astro";
import ProjectScreenshotGallery from "../../components/ProjectScreenshotGallery.astro";
import { getCollection, getEntry } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection("project");
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry("project", slug);
const { Content } = await entry.render();

const articleClasses = `relative prose prose-zinc dark:prose-invert max-w-4xl prose-headings:font-geist-mono prose-headings:font-bold font-geist text-lg dark:prose-headings:!text-zinc-100 prose-blockquote:border-s-accent prose-hr:border-accent/25 dark:prose-hr:border-zinc-700`;
---

<Base title={entry.data.name} description={entry.data.description} og={entry.data.ogImage}>
  <Page>
    <article class="border-l border-r border-accent/20 dark:border-zinc-800 w-full flex flex-col divide-y divide-accent/20 dark:divide-zinc-800">
      <div class="flex md:divide-x divide-accent/20 dark:divide-zinc-800">
        <div class="site-left-rail hidden md:block pt-8"></div>
        <div class="max-w-4xl w-full px-8 md:px-16 pt-8">
          <BackButton />
          <div class="mb-8 space-y-4">
            <h1>
              <DecodeText
                client:load
                decodeByWord
                initialDelay={0}
                revealInterval={40}
                className="text-3xl md:text-4xl font-geist-mono font-bold tracking-tight text-zinc-900 dark:text-zinc-50"
                value={entry.data.name}
              />
            </h1>
            <p class="leading-relaxed text-zinc-700 dark:text-zinc-300 font-geist text-lg">
              {entry.data.description}
            </p>
            <div class="flex items-center gap-3">
              {
                entry.data.githubUrl && (
                  <ExternalLink
                    href={entry.data.githubUrl}
                    class="inline-flex items-center gap-1.5 text-sm font-geist-mono text-zinc-600 hover:text-accent dark:text-zinc-300 dark:hover:text-accent transition-colors"
                  >
                    <i class="ph ph-github-logo text-base" /> GitHub
                  </ExternalLink>
                )
              }
              {
                entry.data.publicUrl && (
                  <ExternalLink
                    href={entry.data.publicUrl}
                    class="inline-flex items-center gap-1.5 text-sm font-geist-mono text-zinc-600 hover:text-accent dark:text-zinc-300 dark:hover:text-accent transition-colors"
                  >
                    <i class="ph ph-globe text-base" /> Visit
                  </ExternalLink>
                )
              }
            </div>
          </div>
        </div>
        <div class="site-right-rail hidden md:block pt-8"></div>
      </div>

      {
        entry.data.screenshots.length > 0 && (
          <div class="flex md:divide-x divide-accent/20 dark:divide-zinc-800">
            <div class="site-left-rail hidden md:block" />
            <div class="max-w-4xl w-full px-8 md:px-16 py-8">
              <ProjectScreenshotGallery
                projectName={entry.data.name}
                screenshots={entry.data.screenshots}
              />
            </div>
            <div class="site-right-rail hidden md:block" />
          </div>
        )
      }

      <div class="flex md:divide-x divide-accent/20 dark:divide-zinc-800 relative">
        <div class="site-left-rail hidden md:block"></div>
        <div class="max-w-4xl w-full px-8 md:px-16 py-4 md:py-8 pb-12">
          <div class={articleClasses} data-pagefind-body>
            <Content components={{ ImageGallery }} />
          </div>
        </div>
        <div class="site-right-rail hidden md:block"></div>
      </div>
    </article>
  </Page>
</Base>
