---
import Page from "src/components/page.astro";
import BaseLayout from "src/layouts/base-layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("project")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---
<BaseLayout>
  <Page>
    { projects.map(p => <><h1>{p.data.title}</h1></>) }
  </Page>
</BaseLayout>
