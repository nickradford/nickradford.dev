---
type Props = {
  bottom: boolean;
};

const { bottom } = Astro.props;
---

<div class="z-10 text-orange/40 dark:text-zinc-700">
  <svg
    class="pointer-events-none absolute left-0 top-0 size-4 -translate-x-1/2 -translate-y-1/2"
    viewBox="0 0 8 8"
  >
    <line x1="4" y1="0" x2="4" y2="8" stroke="currentColor" stroke-width="1"
    ></line>
    <line x1="0" y1="4" x2="8" y2="4" stroke="currentColor" stroke-width="1"
    ></line>
  </svg>
  <svg
    class="pointer-events-none absolute right-0 top-0 size-4 -translate-y-1/2 translate-x-1/2"
    viewBox="0 0 8 8"
  >
    <line x1="4" y1="0" x2="4" y2="8" stroke="currentColor" stroke-width="1"
    ></line>
    <line x1="0" y1="4" x2="8" y2="4" stroke="currentColor" stroke-width="1"
    ></line>
  </svg>

  {
    bottom && (
      <>
        <svg
          class="pointer-events-none absolute bottom-0 left-0 size-4 -translate-x-1/2 translate-y-1/2"
          viewBox="0 0 8 8"
        >
          <line
            x1="4"
            y1="0"
            x2="4"
            y2="8"
            stroke="currentColor"
            stroke-width="1"
          />
          <line
            x1="0"
            y1="4"
            x2="8"
            y2="4"
            stroke="currentColor"
            stroke-width="1"
          />
        </svg>
        <svg
          class="pointer-events-none absolute bottom-0 right-0 size-4 translate-x-1/2 translate-y-1/2"
          viewBox="0 0 8 8"
        >
          <line
            x1="4"
            y1="0"
            x2="4"
            y2="8"
            stroke="currentColor"
            stroke-width="1"
          />
          <line
            x1="0"
            y1="4"
            x2="8"
            y2="4"
            stroke="currentColor"
            stroke-width="1"
          />
        </svg>
      </>
    )
  }
</div>
