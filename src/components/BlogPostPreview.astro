---
import Frame from "./Frame.astro";
import AiAssistedBadge from "./AiAssistedBadge.astro";
import type { BlogPost } from "../lib/content";
import { formatDate } from "../lib/format-date";

interface Props {
  post: BlogPost;
  lastPost?: boolean;
}

const { post, lastPost } = Astro.props;


---

<a
  href={`/blog/${post.slug}`}
  class="block group px-8 md:px-16 py-6 no-underline hover:text-inherit hover:bg-accent/5 transition-colors relative"
>
  <article class="flex flex-col space-y-3">
    <div class="space-y-2">
      <div class="flex items-center gap-3">
        <time
          class="text-xs uppercase tracking-widest text-accent/75 dark:text-zinc-500 font-geist-mono"
        >
          {formatDate(post.date)}
        </time>
        {
          post.draft && (
            <span class="text-xs uppercase tracking-widest font-geist-mono font-medium px-2 py-1 bg-accent/20 dark:bg-accent/10 text-accent rounded">
              Draft
            </span>
          )
        }
        {
          post.aiAssisted && (
            <AiAssistedBadge id={`preview-${post.slug}`} />
          )
        }
      </div>
      <h3
        class="text-2xl font-geist-mono font-bold tracking-tight text-zinc-900 dark:text-zinc-50 group-hover:text-accent dark:group-hover:text-accent transition-colors"
      >
        {post.title}
      </h3>
    </div>
    <p class="leading-relaxed text-zinc-700 dark:text-zinc-300 prose font-geist">
      {post.excerpt}
    </p>
    <span
      class="text-sm font-geist-mono font-medium text-zinc-600 group-hover:text-accent dark:text-zinc-400 dark:group-hover:text-accent transition-colors pt-2"
    >
      Read more <i class="ph ph-arrow-right top-px relative"></i>
    </span>
  </article>
  <Frame corners={lastPost ? ["top", "bottomLeft"] : ["top"]} />
</a>
