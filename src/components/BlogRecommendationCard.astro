---
import type { BlogPost } from "../lib/content";
import { formatDate } from "../lib/format-date";

interface Props {
  post: BlogPost;
  eyebrow?: string;
}

const { post, eyebrow } = Astro.props;
---

<a
  href={`/blog/${post.slug}`}
  class="group flex h-full min-h-64 flex-col border border-orange/20 bg-ivory p-5 no-underline transition-colors hover:bg-orange/5 dark:border-zinc-800 dark:bg-zinc-950 dark:hover:bg-zinc-900/60"
>
  <article class="flex h-full flex-col">
    <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-geist-mono text-xs uppercase tracking-widest text-zinc-500 dark:text-zinc-500">
      {eyebrow && <span class="font-bold text-orange dark:text-orange">{eyebrow}</span>}
      <time>{formatDate(post.date, { dateStyle: "medium" })}</time>
    </div>

    <h3 class="font-geist-mono text-lg font-bold leading-snug text-zinc-900 transition-colors group-hover:text-orange dark:text-zinc-50 dark:group-hover:text-orange">
      {post.title}
    </h3>

    <p class="mt-3 line-clamp-4 font-geist text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
      {post.excerpt}
    </p>

    <div class="mt-auto flex items-center justify-between gap-3 pt-5 font-geist-mono text-xs text-zinc-500 dark:text-zinc-500">
      <span>{post.readingTime.text}</span>
      <span class="font-medium text-zinc-700 transition-colors group-hover:text-orange dark:text-zinc-300 dark:group-hover:text-orange">
        Read <i class="ph ph-arrow-right relative top-px"></i>
      </span>
    </div>
  </article>
</a>
