---
import { SITE } from "../lib/site";
import ExternalLink from "./external-link.astro";
---

<ExternalLink
  href={`${SITE}/feeds/atom.xml`}
  class="group -ml-2 inline-block p-2 text-zinc-600 transition-colors hover:text-orange dark:text-zinc-200 dark:hover:text-orange"
>
  <i class="ph ph-rss"></i>
  <span class="sr-only" id="rss-feed"> RSS Feed </span>
</ExternalLink>
