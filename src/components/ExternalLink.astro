---
interface Props {
  href: string;
  class?: string;
  title?: string;
  icon?: string;
  nofollow?: boolean;
}

const { href, class: className = "", title = "", icon, nofollow = false } = Astro.props;
const rel = ["noopener", nofollow && "nofollow"].filter(Boolean).join(" ");
---

<a href={href} class={className} target="_blank" rel={rel} title={title}>
  <slot />
  {icon && <i class:list={["ph relative top-0.5", `ph-${icon}`]} />}
</a>
