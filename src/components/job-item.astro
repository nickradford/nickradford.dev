---
interface Props {
  company: string;
  extraInfo?: string;
  img: any;
  role: string;
  startDate: string;
  endDate: string;
}

const { company, extraInfo, img, role, startDate, endDate } =
  Astro.props as Props;

const imgSrc = (img as any).src || img;
---

<li class="flex items-start gap-4">
  <div
    class="relative flex h-10 w-10 flex-none items-center justify-center rounded-full bg-zinc-200/75 shadow-md ring-1 ring-zinc-300/75 dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:shadow-zinc-800/5 dark:ring-0 dark:ring-zinc-900/5"
  >
    <img src={imgSrc} class="h-7 w-7 rounded-full" alt={`${company} logo`} />
  </div>
  <dl class="flex flex-auto flex-wrap gap-x-2">
    <dt class="sr-only">Company</dt>
    <dd
      class="w-full flex-none text-sm font-medium text-zinc-600 dark:text-zinc-100"
    >
      {company}
      {
        extraInfo && (
          <span class="text-xs font-normal text-zinc-400">({extraInfo})</span>
        )
      }
    </dd>
    <dt class="sr-only">Role</dt>
    <dd class="text-xs text-zinc-500 dark:text-zinc-400">
      {role}
    </dd>
    <dt class="sr-only">Date</dt>
    <dd
      class="text-xs text-zinc-500/75 dark:text-zinc-500 md:ml-auto"
      aria-label={`${startDate} until ${endDate}`}
    >
      <time datetime={startDate}>{startDate}</time>
      {" "}
      <span aria-hidden="true">—</span>
      {" "}
      <time datetime={endDate}>{endDate}</time>
    </dd>
  </dl>
</li>
