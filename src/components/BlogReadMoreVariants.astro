---
import WhichlyVariant from "@whichly/astro/components/WhichlyVariant.astro";
import BlogReadMoreGrid from "./BlogReadMoreGrid.astro";
import WhichlyPreviewBlock from "./WhichlyPreviewBlock.astro";
import type { BlogPost } from "../lib/content";
import {
  getAdjacentPosts,
  getLatestReadMorePosts,
  getRelatedPostsByTags,
} from "../lib/blog-recommendations";

type RecommendationItem = {
  post: BlogPost;
  eyebrow?: string;
};

interface Props {
  currentPost: BlogPost;
  posts: BlogPost[];
}

const { currentPost, posts } = Astro.props;
const latestItems: RecommendationItem[] = getLatestReadMorePosts(
  posts,
  currentPost.slug,
).map((post, index) => ({
  post,
  eyebrow: index === 0 ? "Latest" : "Recent",
}));

const adjacentPosts = getAdjacentPosts(posts, currentPost.slug);
const adjacentItems: RecommendationItem[] = [
  adjacentPosts.newer && { post: adjacentPosts.newer, eyebrow: "Newer" },
  adjacentPosts.older && { post: adjacentPosts.older, eyebrow: "Older" },
].filter(Boolean) as RecommendationItem[];

const relatedItems: RecommendationItem[] = getRelatedPostsByTags(
  posts,
  currentPost,
).map(({ post, sharedTags }) => ({
  post,
  eyebrow: sharedTags.slice(0, 2).join(" + "),
}));

const fallbackRelatedItems = relatedItems.length > 0 ? relatedItems : latestItems;
const hasRecommendations =
  fallbackRelatedItems.length > 0 ||
  adjacentItems.length > 0 ||
  latestItems.length > 0;
---

{
  hasRecommendations && (
    <WhichlyPreviewBlock name="read-more">
      <WhichlyVariant name="related-tags">
        <BlogReadMoreGrid
          headingId="read-more-related-tags"
          title={relatedItems.length > 0 ? "Related by tag" : "Latest writing"}
          description={
            relatedItems.length > 0
              ? "More posts that overlap with this one."
              : "The newest writing from the archive."
          }
          items={fallbackRelatedItems}
        />
      </WhichlyVariant>

      <WhichlyVariant name="next-previous">
        <BlogReadMoreGrid
          headingId="read-more-next-previous"
          title="Next and previous"
          description="Move through the archive by publish date."
          items={adjacentItems}
        />
      </WhichlyVariant>

      <WhichlyVariant name="latest">
        <BlogReadMoreGrid
          headingId="read-more-latest"
          title="Latest writing"
          description="The newest posts from the archive."
          items={latestItems}
        />
      </WhichlyVariant>
    </WhichlyPreviewBlock>
  )
}
