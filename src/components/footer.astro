---
import { links } from "../../links";
import ExternalLink from "./external-link.astro";

const currentYear = new Date().getFullYear();
---

<style>
  .copyright-bg {
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 2px,
      rgb(255 123 0 / 0.1) 2px,
      rgb(255 123 0 / 0.1) 4px
    );
  }

  :global(.dark) .copyright-bg {
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 2px,
      rgb(113 113 122 / 0.3) 2px,
      rgb(113 113 122 / 0.3) 4px
    );
  }
</style>

<>
  {/* Desktop Footer */}
  <footer
    class="hidden w-full divide-x divide-orange/20 border border-orange/20 dark:divide-zinc-800 dark:border-zinc-800 md:flex"
  >
    <div class="flex-1 px-8 py-6 md:px-16"></div>
    <div
      class="flex w-full max-w-4xl divide-x divide-orange/20 dark:divide-zinc-800"
    >
      <nav
        class="flex flex-1 border-orange/20 px-8 dark:divide-zinc-800 md:px-16"
      >
        {
          links.map(([href, label, icon]) => (
            <ExternalLink
              href={href}
              icon={icon}
              class="block border-l border-orange/20 px-8 py-6 font-geist-mono text-sm font-medium text-zinc-600 transition-colors last:border-r hover:bg-orange/5 hover:text-orange dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-orange md:px-4"
            >
              {label}
            </ExternalLink>
          ))
        }
      </nav>
      <span
        class="copyright-bg flex items-center border-l border-orange/20 px-8 py-6 text-sm text-orange dark:border-zinc-800 dark:text-zinc-400 md:px-16"
      >
        &copy; {currentYear}
      </span>
    </div>
    <div class="flex-1 px-8 py-6 md:px-16"></div>
  </footer>

  {/* Mobile Footer */}
  <footer
    class="w-full border-t border-orange/20 px-8 py-6 dark:border-zinc-800 md:hidden"
  >
    <nav class="mb-4 flex flex-wrap justify-center gap-8">
      {
        links.map(([href, label, icon]) => (
          <ExternalLink
            href={href}
            icon={icon}
            class="font-geist-mono text-sm font-medium text-zinc-600 transition-colors hover:text-orange dark:text-zinc-400 dark:hover:text-orange"
          >
            {label}
          </ExternalLink>
        ))
      }
    </nav>
    <div class="text-center">
      <span class="text-sm text-zinc-600 dark:text-zinc-400">
        &copy; {currentYear}
      </span>
    </div>
  </footer>
</>
