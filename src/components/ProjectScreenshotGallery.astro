---
interface Props {
  projectName: string;
  screenshots: string[];
}

const { projectName, screenshots } = Astro.props;
const mediaItems = screenshots.map((src, index) => {
  const srcWithoutQuery = src.toLowerCase().split("?")[0];
  const type = srcWithoutQuery.endsWith(".mp4") ? "video" : "image";

  return {
    src,
    type,
    alt: `${projectName} ${type === "video" ? "video" : "screenshot"} ${index + 1}`,
  };
});
---

<div class="project-screenshot-gallery" data-project-screenshot-gallery>
  <div class="columns-1 gap-4 md:columns-2">
    {
      mediaItems.map((item, index) => {
        return (
          <button
            type="button"
            class="group mb-4 block w-full break-inside-avoid overflow-hidden rounded-lg bg-zinc-100 text-left ring-1 ring-accent/20 transition hover:ring-accent/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:bg-zinc-900 dark:ring-zinc-700 dark:hover:ring-accent/50"
            data-project-gallery-trigger
            data-project-gallery-index={index}
            data-project-gallery-src={item.src}
            data-project-gallery-type={item.type}
            data-project-gallery-alt={item.alt}
            aria-label={`Open ${item.alt}`}
          >
            {
              item.type === "video" ? (
                <video
                  src={item.src}
                  aria-label={item.alt}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  class="w-full bg-zinc-100 transition duration-200 group-hover:scale-[1.015] dark:bg-zinc-900"
                />
              ) : (
                <img
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  class="w-full bg-zinc-100 transition duration-200 group-hover:scale-[1.015] dark:bg-zinc-900"
                />
              )
            }
          </button>
        );
      })
    }
  </div>

  <div
    class="project-screenshot-lightbox fixed inset-0 z-50 px-4 py-6 sm:px-8"
    data-project-gallery-lightbox
    hidden
    aria-hidden="true"
  >
    <button
      type="button"
      class="absolute inset-0 cursor-default bg-zinc-950/80 backdrop-blur-sm"
      data-project-gallery-backdrop
      aria-label="Close image viewer"
    >
    </button>

    <div
      class="project-screenshot-lightbox__panel relative z-10 flex min-h-full items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-label={`${projectName} media viewer`}
      tabindex="-1"
      data-project-gallery-panel
    >
      <button
        type="button"
        class="absolute right-0 top-0 inline-flex size-11 items-center justify-center rounded-full border border-white/10 bg-zinc-950/70 text-zinc-100 shadow-lg transition hover:bg-zinc-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:right-2 sm:top-2"
        data-project-gallery-close
        aria-label="Close image viewer"
      >
        <i class="ph ph-x text-xl" aria-hidden="true"></i>
      </button>

      <button
        type="button"
        class="absolute left-0 top-1/2 z-20 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-zinc-950/70 text-zinc-100 shadow-lg transition hover:bg-zinc-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:left-2"
        data-project-gallery-prev
        aria-label="Previous media"
      >
        <i class="ph ph-caret-left text-2xl" aria-hidden="true"></i>
      </button>

      <img
        src={mediaItems[0]?.type === "image" ? mediaItems[0].src : undefined}
        alt={mediaItems[0]?.alt ?? `${projectName} screenshot 1`}
        class="max-h-[82vh] max-w-[88vw] rounded-lg bg-zinc-950 object-contain shadow-2xl ring-1 ring-white/10"
        data-project-gallery-image
      />
      <video
        src={mediaItems[0]?.type === "video" ? mediaItems[0].src : undefined}
        aria-label={mediaItems[0]?.alt ?? `${projectName} video 1`}
        autoplay
        muted
        controls
        playsinline
        class="max-h-[82vh] max-w-[88vw] rounded-lg bg-zinc-950 object-contain shadow-2xl ring-1 ring-white/10"
        data-project-gallery-video
        hidden
      >
      </video>

      <button
        type="button"
        class="absolute right-0 top-1/2 z-20 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-zinc-950/70 text-zinc-100 shadow-lg transition hover:bg-zinc-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:right-2"
        data-project-gallery-next
        aria-label="Next media"
      >
        <i class="ph ph-caret-right text-2xl" aria-hidden="true"></i>
      </button>

      <div
        class="absolute bottom-0 left-1/2 -translate-x-1/2 rounded-full border border-white/10 bg-zinc-950/70 px-3 py-1.5 font-geist-mono text-xs font-medium text-zinc-100 shadow-lg sm:bottom-2"
        data-project-gallery-counter
        aria-live="polite"
      >
        1 / {screenshots.length}
      </div>
    </div>
  </div>
</div>

<script>
  type GalleryElement = HTMLElement & {
    _projectScreenshotGalleryCleanup?: () => void;
  };

  type GalleryItem = {
    src: string;
    alt: string;
    type: "image" | "video";
  };

  function initProjectScreenshotGalleries() {
    document
      .querySelectorAll<GalleryElement>("[data-project-screenshot-gallery]")
      .forEach((gallery) => {
        if (gallery._projectScreenshotGalleryCleanup) return;

        const abortController = new AbortController();
        const { signal } = abortController;
        const triggers = Array.from(
          gallery.querySelectorAll<HTMLButtonElement>("[data-project-gallery-trigger]"),
        );
        const lightbox = gallery.querySelector<HTMLElement>("[data-project-gallery-lightbox]");
        const panel = gallery.querySelector<HTMLElement>("[data-project-gallery-panel]");
        const image = gallery.querySelector<HTMLImageElement>("[data-project-gallery-image]");
        const video = gallery.querySelector<HTMLVideoElement>("[data-project-gallery-video]");
        const counter = gallery.querySelector<HTMLElement>("[data-project-gallery-counter]");
        const closeButton = gallery.querySelector<HTMLButtonElement>("[data-project-gallery-close]");
        const backdrop = gallery.querySelector<HTMLButtonElement>(
          "[data-project-gallery-backdrop]",
        );
        const previousButton = gallery.querySelector<HTMLButtonElement>(
          "[data-project-gallery-prev]",
        );
        const nextButton = gallery.querySelector<HTMLButtonElement>("[data-project-gallery-next]");

        if (
          triggers.length === 0 ||
          !lightbox ||
          !panel ||
          !image ||
          !video ||
          !counter ||
          !closeButton ||
          !backdrop ||
          !previousButton ||
          !nextButton
        ) {
          return;
        }

        const items: GalleryItem[] = triggers.map((trigger, index) => ({
          src: trigger.dataset.projectGallerySrc ?? "",
          alt: trigger.dataset.projectGalleryAlt ?? `Project screenshot ${index + 1}`,
          type: trigger.dataset.projectGalleryType === "video" ? "video" : "image",
        }));

        let activeIndex = 0;
        let activeTrigger: HTMLButtonElement | null = null;
        let closeTimer = 0;
        let originalBodyOverflow: string | null = null;

        const setBodyLocked = (locked: boolean) => {
          if (locked) {
            if (originalBodyOverflow === null) {
              originalBodyOverflow = document.body.style.overflow;
            }
            document.body.style.overflow = "hidden";
            return;
          }

          if (originalBodyOverflow !== null) {
            document.body.style.overflow = originalBodyOverflow;
            originalBodyOverflow = null;
          }
        };

        const pauseVideo = () => {
          video.pause();
          video.removeAttribute("src");
          video.load();
        };

        const updateMedia = () => {
          const current = items[activeIndex];
          if (!current) return;

          if (current.type === "video") {
            image.hidden = true;
            image.removeAttribute("src");
            video.hidden = false;
            video.src = current.src;
            video.setAttribute("aria-label", current.alt);
            video.play().catch(() => undefined);
          } else {
            pauseVideo();
            video.hidden = true;
            image.hidden = false;
            image.src = current.src;
            image.alt = current.alt;
          }

          counter.textContent = `${activeIndex + 1} / ${items.length}`;
        };

        const showMedia = (index: number) => {
          activeIndex = (index + items.length) % items.length;
          updateMedia();
        };

        const syncVideoFromTrigger = (trigger: HTMLButtonElement) => {
          const thumbnailVideo = trigger.querySelector<HTMLVideoElement>("video");
          if (!thumbnailVideo || video.hidden) return;

          const syncCurrentTime = () => {
            if (Number.isFinite(thumbnailVideo.currentTime)) {
              video.currentTime = thumbnailVideo.currentTime;
            }
            video.play().catch(() => undefined);
          };

          if (video.readyState >= HTMLMediaElement.HAVE_METADATA) {
            syncCurrentTime();
          } else {
            video.addEventListener("loadedmetadata", syncCurrentTime, { once: true });
          }
        };

        const openLightbox = (index: number, trigger: HTMLButtonElement) => {
          window.clearTimeout(closeTimer);
          activeTrigger = trigger;
          showMedia(index);
          syncVideoFromTrigger(trigger);
          setBodyLocked(true);
          lightbox.hidden = false;
          lightbox.setAttribute("aria-hidden", "false");

          window.requestAnimationFrame(() => {
            lightbox.dataset.open = "true";
            closeButton.focus();
          });
        };

        const closeLightbox = (restoreFocus = true, immediate = false) => {
          if (lightbox.hidden) return;

          window.clearTimeout(closeTimer);
          delete lightbox.dataset.open;
          lightbox.setAttribute("aria-hidden", "true");
          setBodyLocked(false);

          const finishClose = () => {
            lightbox.hidden = true;
            pauseVideo();
            if (restoreFocus) {
              activeTrigger?.focus();
            }
            activeTrigger = null;
          };

          if (immediate) {
            finishClose();
          } else {
            closeTimer = window.setTimeout(finishClose, 180);
          }
        };

        const goPrevious = () => {
          showMedia(activeIndex - 1);
        };

        const goNext = () => {
          showMedia(activeIndex + 1);
        };

        triggers.forEach((trigger, index) => {
          trigger.addEventListener(
            "click",
            () => {
              openLightbox(index, trigger);
            },
            { signal },
          );
        });

        closeButton.addEventListener("click", () => closeLightbox(), { signal });
        backdrop.addEventListener("click", () => closeLightbox(), { signal });
        panel.addEventListener(
          "click",
          (event) => {
            if (event.target === panel) {
              closeLightbox();
            }
          },
          { signal },
        );
        previousButton.addEventListener("click", goPrevious, { signal });
        nextButton.addEventListener("click", goNext, { signal });

        document.addEventListener(
          "keydown",
          (event) => {
            if (lightbox.hidden) return;

            if (event.key === "Escape") {
              event.preventDefault();
              closeLightbox();
              return;
            }

            if (event.key === "ArrowLeft") {
              event.preventDefault();
              goPrevious();
              return;
            }

            if (event.key === "ArrowRight") {
              event.preventDefault();
              goNext();
            }
          },
          { signal },
        );

        gallery._projectScreenshotGalleryCleanup = () => {
          abortController.abort();
          closeLightbox(false, true);
          delete gallery._projectScreenshotGalleryCleanup;
        };
      });
  }

  function destroyProjectScreenshotGalleries() {
    document
      .querySelectorAll<GalleryElement>("[data-project-screenshot-gallery]")
      .forEach((gallery) => {
        gallery._projectScreenshotGalleryCleanup?.();
      });
  }

  if (!(window as typeof window & { __projectScreenshotGalleryEventsBound?: boolean })
    .__projectScreenshotGalleryEventsBound) {
    (window as typeof window & { __projectScreenshotGalleryEventsBound?: boolean })
      .__projectScreenshotGalleryEventsBound = true;
    document.addEventListener("astro:page-load", initProjectScreenshotGalleries);
    document.addEventListener("astro:before-swap", destroyProjectScreenshotGalleries);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectScreenshotGalleries, { once: true });
  } else {
    initProjectScreenshotGalleries();
  }
</script>

<style>
  .project-screenshot-lightbox {
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .project-screenshot-lightbox[data-open="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .project-screenshot-lightbox__panel {
    opacity: 0;
    transform: scale(0.97);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .project-screenshot-lightbox[data-open="true"] .project-screenshot-lightbox__panel {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-screenshot-lightbox,
    .project-screenshot-lightbox__panel {
      transition: none;
    }

    .project-screenshot-lightbox__panel {
      transform: none;
    }
  }
</style>
