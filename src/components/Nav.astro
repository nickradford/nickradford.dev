---
import { Toggle } from "astro-theme-toggle/components"
import NavLinks from "./NavLinks.astro";
import SearchTrigger from "./SearchTrigger.astro";

const currentPath = Astro.url.pathname;
---

<!-- Desktop Header -->
<div
  class="sticky top-0 z-20 w-full bg-ivory/70 dark:bg-zinc-950/70 backdrop-blur-md border-b border-l border-r border-orange/20 dark:border-zinc-800 hidden md:flex"
>
  <div class="flex-1 pt-6 px-8 md:px-16 border-r border-orange/20 dark:border-zinc-800"></div>
  <nav
    id="page-header-nav"
    class="max-w-4xl w-full flex items-stretch relative divide-x divide-orange/20 dark:divide-zinc-800 border-r border-orange/20 dark:border-zinc-800"
  >
    <div class="flex items-center border-orange/20 dark:border-zinc-800">
      <a
        href="/"
        class:list={[
          "text-lg px-8 md:px-16 h-full flex justify-center items-center font-geist-mono font-medium hover:text-orange dark:hover:text-orange transition-colors hover:bg-orange/5",
          currentPath === "/" ? "text-orange bg-orange/5" : "text-zinc-800 dark:text-zinc-100",
        ]}
      >
        Nick&nbsp;Radford
      </a>
    </div>
    <div
      class="flex-grow flex items-stretch justify-center border-r border-orange/20 dark:border-zinc-800"
    >
      <ul
        class={"flex items-stretch px-0 m-0 space-x-8 md:space-x-0 text-sm w-full *:flex-1 *:text-center *:px-4 *:flex *:items-center *:justify-center"}
      >
        <NavLinks currentPath={currentPath} variant="desktop" />
      </ul>
    </div>
    <div class="flex items-stretch justify-end divide-x divide-orange/20 dark:divide-zinc-800">
      <SearchTrigger class="text-lg px-6 py-4" currentPath={currentPath} />
      <Toggle class='flex items-center transition-colors text-zinc-600 hover:text-orange dark:text-zinc-400 dark:hover:text-orange text-lg px-6 py-5'>
        <Fragment slot="icon-light">
          <div class="ph ph-moon-stars"></div>
         </Fragment>
         <Fragment slot="icon-dark">
           <div class="ph ph-sun"></div>
         </Fragment>
      </Toggle>
    </div>
  </nav>
  <div class="flex-1 pt-6 px-8 md:px-16"></div>
</div>

<!-- Mobile Header -->
<div
  class="sticky top-0 z-20 w-full bg-ivory/70 dark:bg-zinc-950/70 backdrop-blur-md border-b border-orange/20 dark:border-zinc-800 md:hidden px-6 pt-6"
>
  <nav id="page-header-nav-mobile" class="flex items-center justify-between relative">
    <a
      href="/"
      class:list={[
        "absolute -top-3 text-sm font-geist-mono font-medium hover:text-orange dark:hover:text-orange transition-colors",
        currentPath === "/" ? "text-orange" : "text-zinc-600 dark:text-zinc-400",
      ]}
    >
      Nick Radford
    </a>
    <ul class="flex px-0 py-4 space-x-8 text-sm">
      <NavLinks currentPath={currentPath} variant="mobile" />
    </ul>

    <div class="flex items-center">
      <SearchTrigger class="text-lg px-4 py-4" currentPath={currentPath} />
      <Toggle class='transition-colors text-zinc-600 hover:text-orange dark:text-zinc-400 dark:hover:text-orange text-lg px-4 py-4'>
        <Fragment slot="icon-light">
          <div class="ph ph-moon-stars"></div>
         </Fragment>
         <Fragment slot="icon-dark">
           <div class="ph ph-sun"></div>
         </Fragment>
      </Toggle>
    </div>
  </nav>
</div>
