---
import ThemeToggle from "./theme-toggle";

const currentPath = Astro.url.pathname;

// Determine if a link is active
const isActive = (href: string): boolean => {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath.startsWith(href);
};

const navLinks = [
  { label: "home", href: "/" },
  { label: "blog", href: "/blog" },
  { label: "projects", href: "/projects" },
  { label: "work", href: "/work" },
];
---

<!-- Desktop Header -->
<div
  class="sticky top-0 z-20 hidden w-full border-b border-l border-r border-orange/20 bg-ivory/70 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/70 md:flex"
>
  <div
    class="flex-1 border-r border-orange/20 px-8 pt-6 dark:border-zinc-800 md:px-16"
  >
  </div>
  <nav
    id="page-header-nav"
    class="relative flex w-full max-w-4xl items-stretch divide-x divide-orange/20 border-r border-orange/20 dark:divide-zinc-800 dark:border-zinc-800"
  >
    <div class="flex items-center border-orange/20 dark:border-zinc-800">
      <a
        href="/"
        class="flex h-full items-center justify-center px-8 font-geist-mono text-lg font-medium text-zinc-800 transition-colors hover:bg-orange/5 hover:text-orange dark:text-zinc-100 dark:hover:text-orange md:px-16"
        data-not-active-styled="true"
      >
        Nick&nbsp;Radford
      </a>
    </div>
    <div
      class="flex flex-grow items-center justify-center border-r border-orange/20 dark:border-zinc-800"
    >
      <ul
        class={"flex px-0 *:py-4 space-x-8 md:space-x-0 text-sm w-full *:flex-1 *:text-center *:px-4"}
      >
        {
          navLinks.map(({ label, href }) => {
            const active = isActive(href);
            return (
              <a
                href={href}
                class={`relative inline-block font-geist-mono text-sm font-medium text-zinc-600 transition-colors hover:text-orange dark:text-zinc-400 dark:hover:text-orange md:border-r md:border-orange/20 md:last:border-none dark:md:border-zinc-800 ${
                  active ? "text-orange dark:text-orange md:bg-orange/5" : ""
                }`}
              >
                {label}
              </a>
            );
          })
        }
      </ul>
    </div>
    <div class="flex items-center justify-end">
      <ThemeToggle client:load />
    </div>
  </nav>
  <div class="flex-1 px-8 pt-6 md:px-16"></div>
</div>

<!-- Mobile Header -->
<div
  class="sticky top-0 z-20 w-full border-b border-orange/20 bg-ivory/70 px-6 pt-6 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/70 md:hidden"
>
  <nav
    id="page-header-nav-mobile"
    class="relative flex items-center justify-between"
  >
    <a
      href="/"
      class="absolute -top-3 font-geist-mono text-sm font-medium text-zinc-600 transition-colors hover:text-orange dark:text-zinc-400 dark:hover:text-orange"
      data-not-active-styled="true"
    >
      Nick Radford
    </a>
    <ul class="flex space-x-8 px-0 py-4 text-sm">
      {
        navLinks.map(({ label, href }) => {
          const active = isActive(href);
          return (
            <a
              href={href}
              class={`relative inline-block font-geist-mono text-sm font-medium text-zinc-600 transition-colors hover:text-orange dark:text-zinc-400 dark:hover:text-orange ${
                active ? "text-orange dark:text-orange" : ""
              }`}
            >
              {label}
              {active && (
                <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-orange md:hidden" />
              )}
            </a>
          );
        })
      }
    </ul>
    <div>
      <ThemeToggle client:load />
    </div>
  </nav>
</div>
