---
import { Toggle } from "astro-theme-toggle/components"
import NavLinks from "./NavLinks.astro";
import SearchTrigger from "./SearchTrigger.astro";

const currentPath = Astro.url.pathname;
---

<!-- Desktop Header -->
<div
  class="sticky top-0 z-20 w-full bg-ivory/70 dark:bg-zinc-950/70 backdrop-blur-md border-b border-l border-r border-accent/20 dark:border-zinc-800 hidden md:flex"
>
  <div class="site-left-rail border-r border-accent/20 dark:border-zinc-800"></div>
  <nav
    id="page-header-nav"
    class="max-w-4xl w-full flex items-stretch relative divide-x divide-accent/20 dark:divide-zinc-800 border-r border-accent/20 dark:border-zinc-800"
  >
    <div class="flex items-center border-accent/20 dark:border-zinc-800">
      <a
        href="/"
        class:list={[
          "text-lg px-8 md:px-16 h-full flex justify-center items-center font-geist-mono font-medium hover:text-accent dark:hover:text-accent transition-colors hover:bg-accent/5",
          currentPath === "/" ? "text-accent bg-accent/5" : "text-zinc-800 dark:text-zinc-100",
        ]}
      >
        Nick&nbsp;Radford
      </a>
    </div>
    <div
      class="flex-grow flex items-stretch justify-center border-r border-accent/20 dark:border-zinc-800"
    >
      <ul
        class={"flex items-stretch px-0 m-0 space-x-8 md:space-x-0 text-sm w-full *:flex-1 *:text-center *:px-4 *:flex *:items-center *:justify-center"}
      >
        <NavLinks currentPath={currentPath} variant="desktop" />
      </ul>
    </div>
    <div class="flex items-stretch justify-end divide-x divide-accent/20 dark:divide-zinc-800">
      <SearchTrigger class="text-lg px-6 py-4" currentPath={currentPath} />
      <div class="theme-toggle-cluster relative flex items-stretch">
        <Toggle class='flex items-center transition-colors text-zinc-600 hover:text-accent dark:text-zinc-400 dark:hover:text-accent text-lg px-6 py-5'>
          <Fragment slot="icon-light">
            <div class="ph ph-moon-stars"></div>
           </Fragment>
           <Fragment slot="icon-dark">
             <div class="ph ph-sun"></div>
           </Fragment>
        </Toggle>
        <div
          class="theme-lab-toggle-actions absolute right-1 top-full mt-1 hidden items-center border border-accent/20 bg-ivory/95 shadow-lg shadow-zinc-900/10 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/95 dark:shadow-black/40 md:flex"
          aria-label="Theme Lab actions"
        >
          <button
            type="button"
            class="inline-flex size-8 items-center justify-center text-zinc-500 transition-colors hover:text-accent dark:text-zinc-400 dark:hover:text-accent"
            data-theme-lab-open
            title="Open Theme Lab"
          >
            <i class="ph ph-palette" aria-hidden="true"></i>
            <span class="sr-only">Open Theme Lab</span>
          </button>
          <button
            type="button"
            class="inline-flex size-8 items-center justify-center border-l border-accent/20 text-zinc-500 transition-colors hover:text-accent dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-accent"
            data-theme-lab-reset
            title="Reset custom theme"
          >
            <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>
            <span class="sr-only">Reset custom theme</span>
          </button>
        </div>
      </div>
    </div>
  </nav>
  <div class="site-right-rail"></div>
</div>

<style>
  .theme-lab-toggle-actions {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.25rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .theme-lab-toggle-actions::before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 100%;
    width: 5.5rem;
    height: 1.25rem;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  :global(html:not([data-theme-lab-found="true"])) .theme-lab-toggle-actions {
    display: none;
  }

  :global(html[data-theme-lab-found="true"])
    .theme-toggle-cluster:hover
    .theme-lab-toggle-actions,
  :global(html[data-theme-lab-found="true"])
    .theme-toggle-cluster:focus-within
    .theme-lab-toggle-actions {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>

<!-- Mobile Header -->
<div
  class="sticky top-0 z-20 w-full bg-ivory/70 dark:bg-zinc-950/70 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800 md:hidden"
>
  <nav id="page-header-nav-mobile" class="relative">
    <div class="flex items-center justify-between px-8 py-3">
      <a
        href="/"
        class:list={[
          "relative text-sm font-geist-mono font-medium hover:text-accent dark:hover:text-accent transition-colors",
          currentPath === "/" ? "text-accent" : "text-zinc-600 dark:text-zinc-400",
        ]}
      >
        Nick Radford
        {
          currentPath === "/" && (
            <span class="absolute -bottom-1 left-0 right-0 h-px bg-accent" />
          )
        }
      </a>
      <div class="flex items-center">
        <SearchTrigger class="text-lg px-3 py-2" currentPath={currentPath} />
        <Toggle class='transition-colors text-zinc-600 hover:text-accent dark:text-zinc-400 dark:hover:text-accent text-lg px-3 py-2'>
        <Fragment slot="icon-light">
          <div class="ph ph-moon-stars"></div>
         </Fragment>
         <Fragment slot="icon-dark">
           <div class="ph ph-sun"></div>
         </Fragment>
        </Toggle>
      </div>
    </div>
    <ul class="flex px-6 text-sm *:flex-1 *:text-center *:py-3">
      <NavLinks currentPath={currentPath} variant="mobile" />
    </ul>
  </nav>
</div>
