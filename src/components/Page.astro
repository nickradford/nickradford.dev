---
import Footer from "./footer.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class={`flex flex-col w-full bg-ivory transition-colors dark:bg-zinc-950 ${className}`}
>
  <main class="w-full flex-1 px-2 md:px-0">
    <slot />
  </main>
  <Footer transition:persist />
</div>
