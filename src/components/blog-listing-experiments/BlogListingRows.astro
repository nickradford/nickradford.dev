---
import type { BlogPost } from "../../lib/content";
import { formatDate } from "../../lib/format-date";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="w-full divide-y divide-orange/20 dark:divide-zinc-800">
  {
    posts.map((post) => (
      <div class="flex md:divide-x divide-orange/20 dark:divide-zinc-800">
        <div class="hidden md:flex flex-1"></div>
        <a
          href={`/blog/${post.slug}`}
          class="group grid max-w-4xl w-full gap-3 px-8 py-4 no-underline transition-colors hover:bg-orange/5 md:grid-cols-[8.5rem_minmax(0,1fr)_5.5rem] md:px-16 dark:hover:bg-zinc-900/40"
        >
          <time class="font-geist-mono text-xs uppercase tracking-widest text-orange/75 dark:text-zinc-500">
            {formatDate(post.date, { dateStyle: "medium" })}
          </time>
          <div class="min-w-0">
            <h2 class="font-geist-mono text-lg font-bold leading-snug tracking-tight text-zinc-900 transition-colors group-hover:text-orange dark:text-zinc-50 dark:group-hover:text-orange">
              {post.title}
            </h2>
            <p class="mt-1 line-clamp-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
              {post.excerpt}
            </p>
          </div>
          <span class="font-geist-mono text-xs text-zinc-500 md:text-right dark:text-zinc-500">
            {post.readingTime.text}
          </span>
        </a>
        <div class="hidden md:flex flex-1"></div>
      </div>
    ))
  }
</div>
