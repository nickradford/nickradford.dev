---
type Props = {
  href: string;
  label: string;
};

const { href, label } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative isolate inline-flex items-center gap-2 border border-orange/30 bg-black px-4 py-2 font-geist-mono text-sm font-medium text-orange/90 text-zinc-600 transition-colors hover:border-orange hover:text-orange dark:border-zinc-700 dark:bg-black dark:text-zinc-400 dark:hover:border-orange dark:hover:text-orange"
>
  <span
    class="absolute inset-0 -z-0 bg-orange/0 transition-colors group-hover:bg-orange/15"
  ></span>
  <span class="z-0">
    {label}{" "}
    <i
      class="ph ph-arrow-up-right pointer-events-none relative left-0 transition-all group-hover:left-1 group-hover:rotate-45"
    ></i>
  </span>
</a>
