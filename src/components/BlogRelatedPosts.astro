---
import type { BlogPost } from "../lib/content";

export type RelatedPostItem = {
  post: BlogPost;
  sharedTags?: string[];
};

interface Props {
  items: RelatedPostItem[];
  isFallback?: boolean;
}

const { items, isFallback = false } = Astro.props;
const displayItems = items.slice(0, 3);
const heading = isFallback ? "Latest writing" : "Related writing";
const getSummary = (post: BlogPost) => post.description ?? post.excerpt;
---

{
  displayItems.length > 0 && (
    <section
      class="dot-grid -mx-8 mt-12 border-y border-orange/20 px-8 py-8 dark:border-zinc-800 md:-mx-16 md:px-16"
      aria-labelledby="related-posts"
    >
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2
          id="related-posts"
          class="font-geist-mono text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50"
        >
          {heading}
        </h2>
        <p class="font-geist-mono text-xs uppercase tracking-[0.18em] text-orange dark:text-orange">
          Read more
        </p>
      </div>

      <ol class="space-y-2">
        {displayItems.map(({ post }) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col gap-2 border-b border-orange/20 py-4 no-underline sm:flex-row sm:items-baseline sm:justify-between dark:border-zinc-800"
            >
              <span class="font-geist-mono text-base font-bold leading-snug text-zinc-900 transition-colors group-hover:text-orange dark:text-zinc-50 dark:group-hover:text-orange">
                {post.title}
              </span>
              <span class="shrink-0 font-geist-mono text-xs text-zinc-500 dark:text-zinc-500">
                {post.readingTime.text} <i class="ph ph-arrow-right relative top-px"></i>
              </span>
            </a>
            <p class="mt-2 max-w-2xl font-geist text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
              {getSummary(post)}
            </p>
          </li>
        ))}
      </ol>
    </section>
  )
}
