---
import type { BlogPost } from "../lib/content";

export type RelatedPostItem = {
  post: BlogPost;
  sharedTags?: string[];
};

interface Props {
  items: RelatedPostItem[];
  isFallback?: boolean;
}

const { items, isFallback = false } = Astro.props;
const displayItems = items.slice(0, 3);
const heading = isFallback ? "Latest writing" : "Related writing";
const getSummary = (post: BlogPost) => post.description ?? post.excerpt;
---

{
  displayItems.length > 0 && (
    <section
      class="dot-grid -mx-8 mt-12 border-t border-orange/20 px-8 py-8 dark:border-zinc-800 md:-mx-16 md:px-16"
      aria-labelledby="related-posts"
    >
      <div class="mb-4">
        <h2
          id="related-posts"
          class="font-geist-mono text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50"
        >
          {heading}
        </h2>
      </div>

      <ol class="space-y-2">
        {displayItems.map(({ post }, index) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class:list={[
                "group block py-4 no-underline",
                index === displayItems.length - 1
                  ? "border-b-0"
                  : "border-b border-orange/20 dark:border-zinc-800",
              ]}
            >
              <span class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                <span class="font-geist-mono text-base font-bold leading-snug text-zinc-900 transition-colors group-hover:text-orange dark:text-zinc-50 dark:group-hover:text-orange">
                  {post.title}
                </span>
                <span class="shrink-0 font-geist-mono text-xs text-zinc-500 transition-colors group-hover:text-orange dark:text-zinc-500 dark:group-hover:text-orange">
                  {post.readingTime.text} <i class="ph ph-arrow-right relative top-px"></i>
                </span>
              </span>
              <span class="mt-2 block max-w-2xl font-geist text-sm leading-relaxed text-zinc-700 transition-colors group-hover:text-zinc-900 dark:text-zinc-300 dark:group-hover:text-zinc-100">
                {getSummary(post)}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}
