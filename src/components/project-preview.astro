---
import Frame from "./frame.astro";
import ProjectLink from "./project-link.astro";

type Props = {
  title: string;
  description: string;
  slug: string;
  bottomFrame: boolean;
  url: string;
  showUrl: boolean;
  gitRepo: string;
  showGitRepo: boolean;
};

const {
  title,
  description,
  slug,
  bottomFrame,
  url,
  showUrl,
  gitRepo,
  showGitRepo,
} = Astro.props;

console.log(Astro.props);
---

<div class="relative">
  <a
    href={`/projects/${slug}`}
    class="group relative block gap-4 space-y-4 px-8 py-6 no-underline transition-colors hover:bg-orange/5 hover:text-inherit md:px-16"
  >
    <h2
      class="font-geist-mono text-2xl font-bold tracking-tight text-zinc-900 transition-colors group-hover:text-orange dark:text-zinc-50"
    >
      {title}
    </h2>
    <p
      class="prose prose-sm font-geist leading-relaxed text-zinc-700 dark:text-zinc-300"
    >
      {description}
    </p>
  </a>
  <Frame bottom={bottomFrame} />
  <footer
    class="relative isolate flex justify-start gap-4 border-t border-orange/20 px-8 py-3 text-orange/35 [--dot-color:currentColor] dark:border-zinc-800 dark:text-zinc-700 md:px-16"
  >
    <div
      class="absolute inset-0 -z-10"
      style={{
        backgroundImage:
          "radial-gradient(circle at 4px 4px, var(--dot-color) 1px, transparent 0)",
        backgroundSize: "26px 26px",
      }}
    >
    </div>
    {gitRepo && showGitRepo && <ProjectLink href={gitRepo} label="GitHub" />}
    {url && showUrl && <ProjectLink href={url} label="Visit" />}
  </footer>
</div>
