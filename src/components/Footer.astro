---
import { links } from "../../navigationLinks";
import ExternalLink from "./ExternalLink.astro";

const currentYear = new Date().getFullYear();
---

<style>
  .copyright-bg {
    position: relative;
    overflow: hidden;
  }

  .copyright-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 2px,
      rgb(255 123 0 / 0.1) 2px,
      rgb(255 123 0 / 0.1) 4px
    );
    mask-image: radial-gradient(
      ellipse at center,
      rgb(0 0 0 / 0.08) 0%,
      rgb(0 0 0 / 0.25) 36%,
      rgb(0 0 0) 100%
    );
    pointer-events: none;
  }

  :global(.dark) .copyright-bg::before {
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 2px,
      rgb(113 113 122 / 0.3) 2px,
      rgb(113 113 122 / 0.3) 4px
    );
  }
</style>

<>
  {/* Desktop Footer */}
  <footer
    class="w-full hidden md:flex border border-orange/20 dark:border-zinc-800 divide-x divide-orange/20 dark:divide-zinc-800"
  >
    <div class="site-left-rail py-6"></div>
    <div class="max-w-4xl w-full flex divide-x divide-orange/20 dark:!divide-zinc-800">
      <nav class="flex-1 flex border-orange/20 dark:divide-zinc-800 px-8 md:px-16">
        {
          links.map(([href, label, icon, download]) => (
            <ExternalLink
              href={href}
              icon={icon}
              download={download}
              class="block py-6 px-8 md:px-4 text-sm font-geist-mono font-medium text-zinc-600 transition-colors hover:text-orange dark:text-zinc-400 dark:hover:text-orange border-l last:border-r hover:bg-orange/5 border-orange/20 dark:border-zinc-800"
            >
              {label}
            </ExternalLink>
          ))
        }
      </nav>
      <span
        class="copyright-bg flex items-center px-8 md:px-16 py-6 text-sm text-orange dark:text-zinc-400"
      >
        <span class="relative">&copy; {currentYear}</span>
      </span>
    </div>
    <div class="site-right-rail py-6"></div>
  </footer>

  {/* Mobile Footer */}
  <footer class="w-full md:hidden border-t border-orange/20 dark:border-zinc-800 px-8 py-6">
    <nav class="flex flex-wrap justify-center gap-8 mb-4">
      {
        links.map(([href, label, icon, download]) => (
          <ExternalLink
            href={href}
            icon={icon}
            download={download}
            class="text-sm font-geist-mono font-medium text-zinc-600 transition-colors hover:text-orange dark:text-zinc-400 dark:hover:text-orange"
          >
            {label}
          </ExternalLink>
        ))
      }
    </nav>
    <div class="text-center">
      <span class="text-sm text-zinc-600 dark:text-zinc-400">
        &copy; {currentYear}
      </span>
    </div>
  </footer>
</>
