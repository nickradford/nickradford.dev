---
import { links } from "../../navigationLinks";
import ExternalLink from "./ExternalLink.astro";

const currentYear = new Date().getFullYear();
---

<>
  {/* Desktop Footer */}
  <footer
    class="w-full hidden md:flex border border-accent/20 dark:border-zinc-800 divide-x divide-accent/20 dark:divide-zinc-800"
  >
    <div class="site-left-rail py-6"></div>
    <div class="dot-grid max-w-4xl w-full flex divide-x divide-accent/20 dark:!divide-zinc-800">
      <nav class="flex-1 flex divide-x divide-accent/20 dark:divide-zinc-800">
        <div class="w-8 shrink-0 md:w-16" aria-hidden="true"></div>
        {
          links.map(([href, label, icon, download]) => (
            <ExternalLink
              href={href}
              icon={icon}
              download={download}
              class="block bg-ivory px-8 py-6 text-sm font-geist-mono font-medium text-zinc-600 transition-colors hover:text-accent dark:bg-zinc-950 dark:text-zinc-400 dark:hover:text-accent md:px-4"
            >
              {label}
            </ExternalLink>
          ))
        }
        <div class="w-8 shrink-0 md:w-16" aria-hidden="true"></div>
      </nav>
      <span
        class="flex items-center bg-ivory px-8 py-6 text-sm text-zinc-500 dark:bg-zinc-950 dark:text-zinc-500 md:px-16"
      >
        <span>&copy; {currentYear}</span>
      </span>
    </div>
    <div class="site-right-rail py-6"></div>
  </footer>

  {/* Mobile Footer */}
  <footer class="w-full md:hidden border-t border-accent/20 dark:border-zinc-800 px-8 py-6">
    <nav class="flex flex-wrap justify-center gap-8 mb-4">
      {
        links.map(([href, label, icon, download]) => (
          <ExternalLink
            href={href}
            icon={icon}
            download={download}
            class="text-sm font-geist-mono font-medium text-zinc-600 transition-colors hover:text-accent dark:text-zinc-400 dark:hover:text-accent"
          >
            {label}
          </ExternalLink>
        ))
      }
    </nav>
    <div class="text-center">
      <span class="text-sm text-zinc-600 dark:text-zinc-400">
        &copy; {currentYear}
      </span>
    </div>
  </footer>
</>
