---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<style is:global>
  [data-whichly-block] > [data-whichly-variant] {
    display: none;
  }

  [data-whichly-block] > [data-whichly-variant]:first-of-type {
    display: contents;
  }
</style>

<div data-whichly-block={name}>
  <slot />
</div>
