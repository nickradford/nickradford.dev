{
  "name": "nickradford.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check-types": "tsc --noemit",
    "dev": "astro dev",
    "build": "astro build && pagefind --site .vercel/output/static",
    "preview": "astro preview",
    "lint": "astro check && bun check-types",
    "prepare": "husky install",
    "og": "bun scripts/social-card.ts",
    "og:regen": "bun og:clean; bun og",
    "og:clean": "rm public/og/*",
    "deploy:worker": "cd worker && bun run deploy"
  },
  "dependencies": {
    "@astrojs/markdoc": "^0.15.9",
    "@astrojs/mdx": "^4.3.12",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "4.0.14",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/vercel": "^9.0.1",
    "@fontsource/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.48",
    "@pagefind/component-ui": "^1.5.0-alpha.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "agentation": "^3.0.2",
    "astro": "^5.16.0",
    "astro-grab": "^0.2.1",
    "astro-meta-tags": "^0.4.0",
    "astro-theme-toggle": "^0.8.0",
    "clsx": "^2.1.1",
    "markdown-it": "^14.1.0",
    "motion": "^12.34.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-code-titles": "^1.1.0",
    "rehype-external-links": "^2.0.1",
    "rehype-prism-plus": "^1.5.0",
    "rehype-slug": "^5.1.0",
    "remark": "^14.0.2",
    "sanitize-html": "^2.17.0",
    "slugify": "^1.6.5",
    "strip-markdown": "^5.0.0",
    "swiper": "^12.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.0",
    "husky": "^8.0.0",
    "pagefind": "^1.4.0",
    "puppeteer": "^24.31.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.9"
}
