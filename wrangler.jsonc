{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nickradford-dev-worker",
	"compatibility_date": "2026-02-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"main": "dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash",
		// Pages must invoke the Worker so the entrypoint can redirect www →
		// apex and serve blog markdown via Accept-header negotiation. Hashed
		// bundles and the search index skip it — nothing links to them on www.
		"run_worker_first": ["/*", "!/_astro/*", "!/pagefind/*"],
	},
	// Worker Previews (branch builds): empty is fine — no vars/secrets/bindings
	// to diverge from production. Assets, compatibility, and routes stay at
	// the top level; routes always target production.
	"previews": {},
	"routes": [
		{ "pattern": "nickradford.dev/*", "zone_name": "nickradford.dev" },
		{ "pattern": "www.nickradford.dev/*", "zone_name": "nickradford.dev" },
	],
}
